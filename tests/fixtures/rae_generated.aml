rows = list_new()
counts = map_new()
vocab = list_new()
haiku_chain_seed(rows, counts, vocab, haiku_seed_words)
syllables = haiku_syllable_cache(vocab)
rng = rng_new(575)
native = zeros(1)
native[0] = -1
candidates = haiku_generate_candidates(rows, counts, vocab, syllables, 5, 0.9, rng, native)
expected_text = ""
expected_text = text_concat(expected_text, "will one rest warm\nthey say subtle his could a\nmaintain protect lose")
assert(text_equal(list_get(candidates, 0), expected_text), "RAE native candidate differs")
assert(haiku_is_haiku(list_get(candidates, 0)), "RAE native candidate form differs")
expected_text = ""
expected_text = text_concat(expected_text, "no him huge whole\nsudden delayed word prove\nselect value cloud")
