rows = list_new()
counts = map_new()
list_push(rows, "rain")
list_push(rows, "finds")
list_push(rows, "stone")
map_set(counts, list_key(list_slice(rows, list_len(rows) - 3, list_len(rows))), 3)
list_push(rows, "finds")
list_push(rows, "stone")
list_push(rows, "rain")
map_set(counts, list_key(list_slice(rows, list_len(rows) - 3, list_len(rows))), 20)
list_push(rows, "a")
list_push(rows, "a")
list_push(rows, "a")
map_set(counts, list_key(list_slice(rows, list_len(rows) - 3, list_len(rows))), 2)
# mixed
source = "rain finds\nstone rain\nI return"
user = list_new()
list_push(user, "rain")
list_push(user, "x")
list_push(user, "x")
list_push(user, "I")
list_push(user, "stone")
list_push(user, "x")
expected = zeros(5)
expected[0] = 0.58000000000000007
expected[1] = 0.83333333333333337
expected[2] = 0.75
expected[3] = 0.47058823529411764
expected[4] = 0.83333333333333337
mathbrain_vector(haiku_mathbrain_features(source, rows, counts, user), expected)
mathbrain_check(haiku_mathbrain_score(parameters, source, rows, counts, user), 0.15182973709927233)
# repeated
source = "a a a a a a"
user = list_new()
expected = zeros(5)
expected[0] = 0.20000000000000001
expected[1] = 0.16666666666666666
expected[2] = 0
expected[3] = 0.35294117647058826
expected[4] = 0.16666666666666666
mathbrain_vector(haiku_mathbrain_features(source, rows, counts, user), expected)
mathbrain_check(haiku_mathbrain_score(parameters, source, rows, counts, user), 0.064398740010735867)
