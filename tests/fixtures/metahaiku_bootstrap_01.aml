IMPORT "../../src/metahaiku.aml"
rng = rng_new(575)
owner = record_new()
record_set(owner, "buffer", list_new())
# empty
spoken = ""
tape = zeros(2)
tape[1] = 0.125
before = list_clone(record_get(owner, "buffer"))
buffer = haiku_meta_bootstrap(record_get(owner, "buffer"), spoken, 0.9, 0.9, rng, tape)
assert(text_equal(list_key(before), list_key(record_get(owner, "buffer"))), "Bootstrap changed its input owner")
assert(tape[0] == 0, "Bootstrap admission draw order differs")
expected = list_new()
assert(text_equal(list_key(buffer), list_key(expected)), "Reflection ordered-list reference differs")
record_set(owner, "buffer", buffer)
# high_dissonance
spoken = ""
spoken = text_concat(spoken, "the first inner shard")
tape = zeros(2)
tape[1] = 0.875
before = list_clone(record_get(owner, "buffer"))
buffer = haiku_meta_bootstrap(record_get(owner, "buffer"), spoken, 0.75, 0, rng, tape)
assert(text_equal(list_key(before), list_key(record_get(owner, "buffer"))), "Bootstrap changed its input owner")
assert(tape[0] == 1, "Bootstrap admission draw order differs")
expected = list_new()
word = ""
word = text_concat(word, "the first inner shard")
list_push(expected, word)
assert(text_equal(list_key(buffer), list_key(expected)), "Reflection ordered-list reference differs")
record_set(owner, "buffer", buffer)
# high_arousal
spoken = ""
spoken = text_concat(spoken, "a bright pulse")
tape = zeros(2)
tape[1] = 0.875
before = list_clone(record_get(owner, "buffer"))
buffer = haiku_meta_bootstrap(record_get(owner, "buffer"), spoken, 0, 0.75, rng, tape)
assert(text_equal(list_key(before), list_key(record_get(owner, "buffer"))), "Bootstrap changed its input owner")
assert(tape[0] == 1, "Bootstrap admission draw order differs")
expected = list_new()
word = ""
word = text_concat(word, "the first inner shard")
list_push(expected, word)
word = ""
word = text_concat(word, "a bright pulse")
list_push(expected, word)
assert(text_equal(list_key(buffer), list_key(expected)), "Reflection ordered-list reference differs")
record_set(owner, "buffer", buffer)
# exact_thresholds
spoken = ""
spoken = text_concat(spoken, "outside the buffer")
tape = zeros(2)
tape[1] = 0.3
before = list_clone(record_get(owner, "buffer"))
buffer = haiku_meta_bootstrap(record_get(owner, "buffer"), spoken, 0.6, 0.6, rng, tape)
assert(text_equal(list_key(before), list_key(record_get(owner, "buffer"))), "Bootstrap changed its input owner")
assert(tape[0] == 1, "Bootstrap admission draw order differs")
expected = list_new()
word = ""
word = text_concat(word, "the first inner shard")
list_push(expected, word)
word = ""
word = text_concat(word, "a bright pulse")
list_push(expected, word)
assert(text_equal(list_key(buffer), list_key(expected)), "Reflection ordered-list reference differs")
record_set(owner, "buffer", buffer)
# diversity
spoken = ""
spoken = text_concat(spoken, "a quieter moment")
tape = zeros(2)
tape[1] = 0.25
before = list_clone(record_get(owner, "buffer"))
buffer = haiku_meta_bootstrap(record_get(owner, "buffer"), spoken, 0, 0, rng, tape)
assert(text_equal(list_key(before), list_key(record_get(owner, "buffer"))), "Bootstrap changed its input owner")
assert(tape[0] == 1, "Bootstrap admission draw order differs")
expected = list_new()
word = ""
word = text_concat(word, "the first inner shard")
list_push(expected, word)
word = ""
word = text_concat(word, "a bright pulse")
list_push(expected, word)
word = ""
word = text_concat(word, "a quieter moment")
list_push(expected, word)
assert(text_equal(list_key(buffer), list_key(expected)), "Reflection ordered-list reference differs")
record_set(owner, "buffer", buffer)
# diversity_boundary
spoken = ""
spoken = text_concat(spoken, "still outside")
tape = zeros(2)
tape[1] = 0.3
before = list_clone(record_get(owner, "buffer"))
buffer = haiku_meta_bootstrap(record_get(owner, "buffer"), spoken, 0, 0, rng, tape)
assert(text_equal(list_key(before), list_key(record_get(owner, "buffer"))), "Bootstrap changed its input owner")
assert(tape[0] == 1, "Bootstrap admission draw order differs")
expected = list_new()
word = ""
word = text_concat(word, "the first inner shard")
list_push(expected, word)
word = ""
word = text_concat(word, "a bright pulse")
list_push(expected, word)
word = ""
word = text_concat(word, "a quieter moment")
list_push(expected, word)
assert(text_equal(list_key(buffer), list_key(expected)), "Reflection ordered-list reference differs")
record_set(owner, "buffer", buffer)
PRINT "HAIKU_META_OK"
