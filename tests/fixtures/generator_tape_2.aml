# Direct pinned Python traces: tests/reference/generator_inputs.json.
# Generator cases: 6
# Result checks: 12
IMPORT "../../src/generator.aml"
# temperature_1_5 (preserved)
rows = list_new()
counts = map_new()
vocab = list_new()
syllables = map_new()
list_push(vocab, "a")
map_set(syllables, "a", 1)
list_push(vocab, "b")
map_set(syllables, "b", 1)
list_push(vocab, "x")
map_set(syllables, "x", 1)
list_push(vocab, "y")
map_set(syllables, "y", 1)
triple = list_new()
list_push(triple, "a")
list_push(triple, "b")
list_push(triple, "x")
haiku_chain_learn(rows, counts, vocab, triple)
map_set(counts, list_key(triple), 1)
triple = list_new()
list_push(triple, "a")
list_push(triple, "b")
list_push(triple, "y")
haiku_chain_learn(rows, counts, vocab, triple)
map_set(counts, list_key(triple), 3)
tape = zeros(3)
tape[1] = 0
tape[2] = 0.4
rng = map_new()
map_set(rng, "scripted", 73)
actual = haiku_generate_line(rows, counts, vocab, syllables, 2, 1.5, rng, tape)
assert(text_equal(actual, "a y"), "temperature_1_5: line")
assert(tape[0] == 2, "temperature_1_5: consumed draws")
assert(map_len(rng) == 1 and map_get(rng, "scripted") == 73, "Scripted sampling changed rng")
