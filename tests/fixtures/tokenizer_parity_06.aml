IMPORT "tokenizer_support.aml"
# Tokenizer references: 415
model = tokenizer_load("../../models/haiku_sp.model")
# unicode_14
source = ""
source = text_concat(source, "é‌ ㍍  ")
actual = haiku_tokenize(source, "regex", model)
expected = list_new()
list_push(expected, "é")
haiku_tokenizer_test_list(actual, expected, "unicode_14 regex")
actual = haiku_trigrams(actual)
expected = list_new()
haiku_tokenizer_test_list(actual, expected, "unicode_14 regex")
actual = haiku_tokenize(source, "sentencepiece", model)
expected = list_new()
list_push(expected, "é‌")
list_push(expected, "メートル")
haiku_tokenizer_test_list(actual, expected, "unicode_14 sentencepiece")
actual = haiku_trigrams(actual)
expected = list_new()
haiku_tokenizer_test_list(actual, expected, "unicode_14 sentencepiece")
actual = tokenizer_pieces(model, text_lower(source))
expected = list_new()
list_push(expected, "▁")
list_push(expected, "é‌")
list_push(expected, "▁")
list_push(expected, "メートル")
haiku_tokenizer_test_list(actual, expected, "unicode_14 native")
