IMPORT "dream_support.aml"
state = dream_test_new(1, "regex")
record_set(state, "dream_config", [10, 0.25, 5])
record_set(state, "turn", 10)
spoken = ""
spoken = text_concat(spoken, "rain holds the cloud\nour two voices move through night\nlight remembers us")
haikus = haiku_dream_run(state, spoken, 0)
expected = list_new()
item = ""
item = text_concat(item, "rain holds the cloud\nour two voices move through night\nlight remembers us")
list_push(expected, item)
item = ""
item = text_concat(item, "cloud light dream cloud light\ndream rain light warm rain wind warm\nnight wind moon night cloud")
list_push(expected, item)
item = ""
item = text_concat(item, "moon dream cloud light dream\nrain light warm rain wind warm night\nwind moon night cloud moon")
list_push(expected, item)
item = ""
item = text_concat(item, "dream cloud light dream rain\nlight warm rain wind warm night wind\nmoon dream cloud moon dream")
list_push(expected, item)
item = ""
item = text_concat(item, "cloud light dream rain light\nwarm night wind warm night wind moon\nnight cloud moon dream cloud")
list_push(expected, item)
assert(text_equal(list_key(haikus), list_key(expected)), "Dream ordered text differs from Python")
expected = list_new()
item = ""
item = text_concat(item, "rain holds the cloud\nour two voices move through night\nlight remembers us")
list_push(expected, item)
