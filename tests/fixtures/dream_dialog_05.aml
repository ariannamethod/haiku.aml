assert(map_len(record_get(state, "counts")) == 39, "Dream feedback added extra transitions")
assert(map_len(record_get(state, "weights")) == 8, "Dream changed the living cloud")
event = map_new()
map_set(event, "quality_after", 0.5)
map_set(event, "novelty", 0)
map_set(event, "dissonance", 0.5)
map_set(event, "turn", 19)
assert(haiku_dream_should(state, event) == 0, "Dream actual-turn cooldown ended early")
record_set(state, "dream_config", [10, 1, 4])
map_set(event, "turn", 20)
assert(haiku_dream_should(state, event) == 1, "Dream actual-turn cooldown failed to reopen")
haiku_dream_check(state)
PRINT "HAIKU_DREAM_OK"
