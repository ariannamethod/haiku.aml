IMPORT "dream_support.aml"
state = dream_test_new(1, "regex")
# cooldown
record_set(state, "dream_config", [10, 0.25, 4])
tape = zeros(2)
tape[1] = 0
record_set(state, "draws", tape)
event = map_new()
map_set(event, "turn", 9)
map_set(event, "quality_after", 0.1)
map_set(event, "novelty", 1)
map_set(event, "dissonance", 0.5)
assert(haiku_dream_should(state, event) == 0, "Dream source trigger differs")
tape = record_get(state, "draws")
assert(tape[0] == 0, "Dream trigger draw order differs")
# quality_equality
record_set(state, "dream_config", [10, 0.25, 4])
tape = zeros(2)
tape[1] = 0
record_set(state, "draws", tape)
event = map_new()
map_set(event, "turn", 10)
map_set(event, "quality_after", 0.45)
map_set(event, "novelty", 0.7)
map_set(event, "dissonance", 0.4)
assert(haiku_dream_should(state, event) == 0, "Dream source trigger differs")
tape = record_get(state, "draws")
assert(tape[0] == 0, "Dream trigger draw order differs")
# quality_below
record_set(state, "dream_config", [10, 0.25, 4])
tape = zeros(2)
tape[1] = 0.25
record_set(state, "draws", tape)
event = map_new()
map_set(event, "turn", 10)
map_set(event, "quality_after", 0.449)
map_set(event, "novelty", 0.7)
map_set(event, "dissonance", 0.4)
assert(haiku_dream_should(state, event) == 1, "Dream source trigger differs")
tape = record_get(state, "draws")
assert(tape[0] == 1, "Dream trigger draw order differs")
# novelty_equality
record_set(state, "dream_config", [10, 0.25, 4])
tape = zeros(2)
tape[1] = 0
record_set(state, "draws", tape)
event = map_new()
map_set(event, "turn", 10)
map_set(event, "quality_after", 0.5)
map_set(event, "novelty", 0.7)
map_set(event, "dissonance", 0.7)
assert(haiku_dream_should(state, event) == 0, "Dream source trigger differs")
tape = record_get(state, "draws")
assert(tape[0] == 0, "Dream trigger draw order differs")
# novelty_above
record_set(state, "dream_config", [10, 0.25, 4])
tape = zeros(2)
tape[1] = 0.125
record_set(state, "draws", tape)
event = map_new()
map_set(event, "turn", 10)
map_set(event, "quality_after", 0.5)
map_set(event, "novelty", 0.701)
map_set(event, "dissonance", 0.7)
assert(haiku_dream_should(state, event) == 1, "Dream source trigger differs")
tape = record_get(state, "draws")
assert(tape[0] == 1, "Dream trigger draw order differs")
# probability_above
record_set(state, "dream_config", [10, 0.25, 4])
tape = zeros(2)
tape[1] = 0.251
record_set(state, "draws", tape)
event = map_new()
map_set(event, "turn", 10)
map_set(event, "quality_after", 0.5)
map_set(event, "novelty", 0.701)
map_set(event, "dissonance", 0.7)
assert(haiku_dream_should(state, event) == 0, "Dream source trigger differs")
tape = record_get(state, "draws")
assert(tape[0] == 1, "Dream trigger draw order differs")
# dissonance_inside
record_set(state, "dream_config", [10, 0.25, 4])
tape = zeros(2)
tape[1] = 0.25
record_set(state, "draws", tape)
event = map_new()
map_set(event, "turn", 10)
map_set(event, "quality_after", 0.5)
map_set(event, "novelty", 0.7)
map_set(event, "dissonance", 0.5)
assert(haiku_dream_should(state, event) == 1, "Dream source trigger differs")
tape = record_get(state, "draws")
assert(tape[0] == 1, "Dream trigger draw order differs")
# dissonance_lower
record_set(state, "dream_config", [10, 0.25, 4])
tape = zeros(2)
tape[1] = 0
record_set(state, "draws", tape)
event = map_new()
map_set(event, "turn", 10)
map_set(event, "quality_after", 0.5)
map_set(event, "novelty", 0.7)
map_set(event, "dissonance", 0.4)
assert(haiku_dream_should(state, event) == 0, "Dream source trigger differs")
tape = record_get(state, "draws")
assert(tape[0] == 0, "Dream trigger draw order differs")
# dissonance_upper
record_set(state, "dream_config", [10, 0.25, 4])
tape = zeros(2)
tape[1] = 0
record_set(state, "draws", tape)
event = map_new()
map_set(event, "turn", 10)
map_set(event, "quality_after", 0.5)
map_set(event, "novelty", 0.7)
map_set(event, "dissonance", 0.7)
assert(haiku_dream_should(state, event) == 0, "Dream source trigger differs")
tape = record_get(state, "draws")
assert(tape[0] == 0, "Dream trigger draw order differs")
# zero_probability_equal
record_set(state, "dream_config", [10, 0, 4])
tape = zeros(2)
tape[1] = 0
record_set(state, "draws", tape)
event = map_new()
map_set(event, "turn", 10)
map_set(event, "quality_after", 0.1)
map_set(event, "novelty", 0)
map_set(event, "dissonance", 0)
assert(haiku_dream_should(state, event) == 1, "Dream source trigger differs")
tape = record_get(state, "draws")
assert(tape[0] == 1, "Dream trigger draw order differs")
# zero_probability_above
record_set(state, "dream_config", [10, 0, 4])
tape = zeros(2)
tape[1] = 0.0625
record_set(state, "draws", tape)
event = map_new()
map_set(event, "turn", 10)
map_set(event, "quality_after", 0.1)
map_set(event, "novelty", 0)
map_set(event, "dissonance", 0)
assert(haiku_dream_should(state, event) == 0, "Dream source trigger differs")
tape = record_get(state, "draws")
assert(tape[0] == 1, "Dream trigger draw order differs")
# one_probability
record_set(state, "dream_config", [10, 1, 4])
tape = zeros(2)
tape[1] = 0.9375
record_set(state, "draws", tape)
event = map_new()
map_set(event, "turn", 10)
map_set(event, "quality_after", 0.1)
map_set(event, "novelty", 0)
map_set(event, "dissonance", 0)
assert(haiku_dream_should(state, event) == 1, "Dream source trigger differs")
tape = record_get(state, "draws")
assert(tape[0] == 1, "Dream trigger draw order differs")
PRINT "HAIKU_DREAM_OK"
