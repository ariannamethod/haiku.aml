IMPORT "tokenizer_support.aml"
# Tokenizer references: 1254
model = tokenizer_load("../../models/haiku_sp.model")
# corpus_04
source = ""
source = text_concat(source, "outside—anywhere—all—mind—evaluate—but—false—unlike—margin—guide—sweet—edge—")
source = text_concat(source, "understand—gradual!?")
actual = haiku_tokenize(source, "regex", model)
expected = list_new()
list_push(expected, "outside")
list_push(expected, "anywhere")
list_push(expected, "all")
list_push(expected, "mind")
list_push(expected, "evaluate")
