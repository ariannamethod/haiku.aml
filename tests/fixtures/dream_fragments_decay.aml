IMPORT "../../src/dream.aml"
state = record_new()
haiku_dream_init(state, list_new())
weights = zeros(1)
item = ""
item = text_concat(item, "old fragment")
list_push(record_get(state, "dream_fragments"), item)
weights[0] = 1
record_set(state, "dream_weights", weights)
cursor = 0
while cursor < 1:
    haiku_dream_fragments(state, "same\nsame\nsame")
    cursor = cursor + 1
assert(list_len(record_get(state, "dream_fragments")) == 4, "Dream decay retention differs")
weights = record_get(state, "dream_weights")
assert(abs(weights[0] - 0.95) < 0.000002, "Dream long decay differs")
assert(abs(weights[1] - 1.0) < 0.000002, "Dream long decay differs")
assert(abs(weights[2] - 1.0) < 0.000002, "Dream long decay differs")
assert(abs(weights[3] - 1.0) < 0.000002, "Dream long decay differs")
item = ""
item = text_concat(item, "old fragment")
assert(text_equal(list_get(record_get(state, "dream_fragments"), 0), item), "Dream old fragment pruning differs")
cursor = 0
while cursor < 42:
    haiku_dream_fragments(state, "same\nsame\nsame")
    cursor = cursor + 1
assert(list_len(record_get(state, "dream_fragments")) == 130, "Dream decay retention differs")
