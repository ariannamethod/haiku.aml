# EXPECT: Haiku vocabulary can exceed the 10000-codepoint haiku limit
IMPORT "../../../src/generator.aml"
rows = list_new()
counts = map_new()
vocab = haiku_words("rain wind cloud")
haiku_chain_learn(rows, counts, vocab, vocab)
syllables = haiku_syllable_cache(vocab)
rng = rng_new(73)
tape = zeros(1)
tape[0] = -1
rows = list_new()
counts = map_new()
vocab = list_new()
word = "b"
cursor = 0
while cursor < 13:
    word = text_concat(word, word)
    cursor = cursor + 1
word = text_concat(word, text_slice(word, 0, 1808))
list_push(vocab, word)
syllables = haiku_syllable_cache(vocab)
# INVALID_CALL
haiku_generate_candidates(rows, counts, vocab, syllables, 1, 1, rng, tape)
ECHO HAIKU_INVALID_ACCEPTED
