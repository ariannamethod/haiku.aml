IMPORT "cloud_support.aml"
observed = list_new()
edges = list_new()
vocab = list_new()
recent = list_new()
observed_counts = map_new()
resonance = map_new()
counts = map_new()
seeds = list_new()
cloud_words_add(seeds, "s e e d")
haiku_chain_seed(edges, counts, vocab, seeds)
wanted = list_new()
cloud_list_check("separate seed observed", observed, wanted)
cloud_number_check("separate seed observer size", map_len(observed_counts), 0)
cloud_number_check("separate seed resonance size", map_len(resonance), 0)
wanted = list_new()
cloud_words_add(wanted, "s e e e e d")
