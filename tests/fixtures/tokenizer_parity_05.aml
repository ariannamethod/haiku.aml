IMPORT "tokenizer_support.aml"
# Tokenizer references: 1174
model = tokenizer_load("../../models/haiku_sp.model")
# corpus_15
source = ""
source = text_concat(source, "THAT\tobvious\tVIA\tproximal\tCALIBRATE,")
actual = haiku_tokenize(source, "regex", model)
expected = list_new()
list_push(expected, "that")
list_push(expected, "obvious")
list_push(expected, "via")
list_push(expected, "proximal")
list_push(expected, "calibrate")
haiku_tokenizer_test_list(actual, expected, "corpus_15 regex")
actual = haiku_trigrams(actual)
