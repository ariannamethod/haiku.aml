piece = ""
piece = text_concat(piece, "big word")
list_push(user, piece)
piece = ""
piece = text_concat(piece, "other thing")
list_push(user, piece)
piece = ""
piece = text_concat(piece, "third token")
list_push(user, piece)
expected = zeros(5)
expected[0] = 0.5
expected[1] = 1
expected[2] = 0
expected[3] = 1
expected[4] = 1
actual = haiku_rae_features(source, user)
haiku_rae_test_vector(actual, expected)
PRINT "HAIKU_RAE_OK"
