IMPORT "rae_support.aml"
# RAE references: 75
# empty
source = ""
user = list_new()
expected = zeros(5)
expected[0] = 0.5
expected[1] = 0
expected[2] = 0
expected[3] = 0
expected[4] = 0
actual = haiku_rae_features(source, user)
haiku_rae_test_vector(actual, expected)
# empty_three
source = ""
source = text_concat(source, "\n\n")
user = list_new()
expected = zeros(5)
expected[0] = 0.5
expected[1] = 0
expected[2] = 0
expected[3] = 0
expected[4] = 1
actual = haiku_rae_features(source, user)
haiku_rae_test_vector(actual, expected)
# mixed_case
source = ""
source = text_concat(source, "Cloud cloud CLOUD\ncloud cloud\ncloud")
user = list_new()
piece = ""
piece = text_concat(piece, "Cloud")
list_push(user, piece)
piece = ""
piece = text_concat(piece, "cloud")
list_push(user, piece)
piece = ""
piece = text_concat(piece, "sky")
list_push(user, piece)
expected = zeros(5)
expected[0] = 0.5
expected[1] = 0.166666666667
expected[2] = 0.333333333333
expected[3] = 0.166666666667
expected[4] = 0.6
actual = haiku_rae_features(source, user)
haiku_rae_test_vector(actual, expected)
# sigma_expansion
source = ""
source = text_concat(source, "ΟΣ ος οσ\nİ I i i̇\nRAIN rain, Rain")
user = list_new()
piece = ""
piece = text_concat(piece, "ος")
list_push(user, piece)
piece = ""
piece = text_concat(piece, "οσ")
list_push(user, piece)
piece = ""
piece = text_concat(piece, "ΟΣ")
list_push(user, piece)
piece = ""
piece = text_concat(piece, "i")
list_push(user, piece)
piece = ""
piece = text_concat(piece, "i̇")
list_push(user, piece)
piece = ""
piece = text_concat(piece, "RAIN")
list_push(user, piece)
expected = zeros(5)
expected[0] = 0.5
expected[1] = 0.6
expected[2] = 0.666666666667
expected[3] = 0.6
expected[4] = 0.818181818182
actual = haiku_rae_features(source, user)
haiku_rae_test_vector(actual, expected)
