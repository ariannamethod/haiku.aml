IMPORT "tokenizer_support.aml"
# Tokenizer references: 1202
model = tokenizer_load("../../models/haiku_sp.model")
# corpus_10
source = ""
source = text_concat(source, "active—express—remain—on—emerge—often—verify—hardly—dead—constraint!?")
actual = haiku_tokenize(source, "regex", model)
expected = list_new()
list_push(expected, "active")
list_push(expected, "express")
list_push(expected, "remain")
list_push(expected, "on")
list_push(expected, "emerge")
list_push(expected, "often")
list_push(expected, "verify")
list_push(expected, "hardly")
list_push(expected, "dead")
list_push(expected, "constraint")
haiku_tokenizer_test_list(actual, expected, "corpus_10 regex")
