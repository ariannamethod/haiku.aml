IMPORT "dream_support.aml"
state = dream_test_new(1, "regex")
record_set(state, "dream_config", [10, 0.25, 1])
record_set(state, "turn", 10)
spoken = ""
spoken = text_concat(spoken, "rain holds the cloud\nour two voices move through night\nlight remembers us")
haikus = haiku_dream_run(state, spoken, 0)
expected = list_new()
item = ""
item = text_concat(item, "rain holds the cloud\nour two voices move through night\nlight remembers us")
list_push(expected, item)
assert(text_equal(list_key(haikus), list_key(expected)), "Dream ordered text differs from Python")
expected = list_new()
item = ""
item = text_concat(item, "rain holds the cloud\nour two voices move through night\nlight remembers us")
list_push(expected, item)
assert(text_equal(list_key(record_get(state, "dream_history")), list_key(expected)), "Dream ordered text differs from Python")
tape = record_get(state, "draws")
assert(tape[0] == 17, "Dream final unrecorded response draw order differs")
assert(record_get(state, "dream_last_turn") == 10, "Dream cooldown must save the actual foreground turn")
dialogs = record_get(state, "dream_dialogs")
assert(len(dialogs) == 3 and dialogs[0] == 10 and dialogs[1] == 0 and dialogs[2] == 1, "Dream dialog metadata differs")
assert(list_len(record_get(state, "dream_fragments")) == 3, "Dream fragment count differs")
weights = record_get(state, "dream_weights")
item = ""
item = text_concat(item, "rain holds the cloud")
assert(text_equal(list_get(record_get(state, "dream_fragments"), 0), item), "Dream fragment text differs")
assert(abs(weights[0] - 1.0) < 0.000002, "Dream fragment decay differs")
item = ""
item = text_concat(item, "our two voices move through night")
assert(text_equal(list_get(record_get(state, "dream_fragments"), 1), item), "Dream fragment text differs")
assert(abs(weights[1] - 1.0) < 0.000002, "Dream fragment decay differs")
item = ""
item = text_concat(item, "light remembers us")
assert(text_equal(list_get(record_get(state, "dream_fragments"), 2), item), "Dream fragment text differs")
assert(abs(weights[2] - 1.0) < 0.000002, "Dream fragment decay differs")
