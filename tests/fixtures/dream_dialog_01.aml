assert(text_equal(list_key(record_get(state, "recent")), list_key(expected)), "Dream ordered text differs from Python")
assert(haiku_chain_count(record_get(state, "counts"), "rain", "cloud", "wind") == 1, "Dream feedback transition differs")
assert(haiku_chain_count(record_get(state, "counts"), "cloud", "wind", "light") == 1, "Dream feedback transition differs")
assert(haiku_chain_count(record_get(state, "counts"), "wind", "light", "moon") == 1, "Dream feedback transition differs")
assert(haiku_chain_count(record_get(state, "counts"), "light", "moon", "warm") == 1, "Dream feedback transition differs")
assert(haiku_chain_count(record_get(state, "counts"), "moon", "warm", "dream") == 1, "Dream feedback transition differs")
assert(haiku_chain_count(record_get(state, "counts"), "warm", "dream", "night") == 1, "Dream feedback transition differs")
assert(haiku_chain_count(record_get(state, "counts"), "rain", "cloud", "light") == 3, "Dream feedback transition differs")
assert(haiku_chain_count(record_get(state, "counts"), "rain", "holds", "the") == 1, "Dream feedback transition differs")
assert(haiku_chain_count(record_get(state, "counts"), "holds", "the", "cloud") == 1, "Dream feedback transition differs")
assert(haiku_chain_count(record_get(state, "counts"), "the", "cloud", "our") == 1, "Dream feedback transition differs")
assert(haiku_chain_count(record_get(state, "counts"), "cloud", "our", "two") == 1, "Dream feedback transition differs")
assert(haiku_chain_count(record_get(state, "counts"), "our", "two", "voices") == 1, "Dream feedback transition differs")
assert(haiku_chain_count(record_get(state, "counts"), "two", "voices", "move") == 1, "Dream feedback transition differs")
assert(haiku_chain_count(record_get(state, "counts"), "voices", "move", "through") == 1, "Dream feedback transition differs")
assert(haiku_chain_count(record_get(state, "counts"), "move", "through", "night") == 1, "Dream feedback transition differs")
assert(haiku_chain_count(record_get(state, "counts"), "through", "night", "light") == 1, "Dream feedback transition differs")
assert(haiku_chain_count(record_get(state, "counts"), "night", "light", "remembers") == 1, "Dream feedback transition differs")
assert(haiku_chain_count(record_get(state, "counts"), "light", "remembers", "us") == 1, "Dream feedback transition differs")
assert(map_len(record_get(state, "counts")) == 18, "Dream feedback added extra transitions")
assert(map_len(record_get(state, "weights")) == 8, "Dream changed the living cloud")
event = map_new()
map_set(event, "quality_after", 0.5)
map_set(event, "novelty", 0)
map_set(event, "dissonance", 0.5)
map_set(event, "turn", 19)
assert(haiku_dream_should(state, event) == 0, "Dream actual-turn cooldown ended early")
record_set(state, "dream_config", [10, 1, 4])
map_set(event, "turn", 20)
assert(haiku_dream_should(state, event) == 1, "Dream actual-turn cooldown failed to reopen")
haiku_dream_check(state)
PRINT "HAIKU_DREAM_OK"
