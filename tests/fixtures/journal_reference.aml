assert(record_get(entry, 'state_revision') == 5, 'Journal state revision differs')
assert(record_get(entry, 'publication_order') == 5, 'Journal publication order differs')
assert(text_equal(record_get(entry, 'input'), source), 'Journal upgrade input index differs')
assert(text_equal(record_get(entry, 'output'), spoken), 'Journal upgrade output index differs')
assert(abs(record_get(entry, 'quality') - 0.5) <= 0.000002, 'Journal quality differs')
