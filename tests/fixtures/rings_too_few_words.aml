# Generated by tests/reference/rings_oracle.py; exact pinned Python receipt.
IMPORT "rings_support.aml"
state = ring_test_state()
record_set(state, "clock", 7)
ring_test_seed(state, "b", 0.25, 0, 3, "seed")
ring_test_seed(state, "a", 0.5, 1, 3, "seed")
recent = list_new()
list_push(recent, "a")
list_push(recent, "d")
list_push(recent, "d")
tape = zeros(1)
record_set(state, "draws", tape)
old = record_clone(state)
receipt = haiku_overthinkg(state, recent)
actual = record_get(receipt, "trigrams")
wanted = list_new()
ring_test_list(actual, wanted)
actual_coherence = record_get(receipt, "coherence")
actual_admission = record_get(receipt, "admission")
assert(len(actual_coherence) == 1, "Ring coherence size differs")
assert(len(actual_admission) == 1, "Ring admission size differs")
ring_test_near(actual_coherence[0], 0)
ring_test_near(actual_admission[0], 0)
actual_tape = record_get(state, "draws")
assert(actual_tape[0] == 0, "Ring draw cursor differs")
ring_test_map(record_get(state, "voice_rng"), record_get(old, "voice_rng"))
ring_test_untouched(state, old)
assert(map_len(record_get(state, "weights")) == 2, "Ring cloud size differs")
assert(map_len(record_get(state, "observer_counts")) == 0, "Ring observer size differs")
ring_test_cloud(state, "b", 0.25, 0, 3, "seed", 0)
ring_test_cloud(state, "a", 0.5, 1, 3, "seed", 1)
expected_rows = list_new()
ring_test_list(record_get(state, "observer_rows"), expected_rows)
record_set(state, "ring_trigrams", actual)
record_set(state, "ring_coherence", actual_coherence)
record_set(state, "ring_admission", actual_admission)
haiku_rings_check(state)
ECHO HAIKU_RINGS_OK
