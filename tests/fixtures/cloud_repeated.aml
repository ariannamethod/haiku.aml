IMPORT "cloud_support.aml"
weights = map_new()
frequency = map_new()
last_used = map_new()
sources = list_new()
seeds = list_new()
cloud_words_add(seeds, "a dormant a")
haiku_cloud_seed(weights, frequency, last_used, sources, seeds, 0.5)
wanted = list_new()
cloud_words_add(wanted, "a dormant")
cloud_list_check("repeated seed words", map_keys(weights), wanted)
wanted = list_new()
cloud_words_add(wanted, "seed seed")
cloud_list_check("repeated seed sources", sources, wanted)
cloud_number_check("repeated seed frequency size", map_len(frequency), 2)
cloud_number_check("repeated seed time size", map_len(last_used), 2)
group = list_new()
cloud_words_add(group, "a dormant")
values = [1, 0, 0.5]
cloud_word_group("repeated seed", weights, frequency, last_used, group, values)
active = list_new()
list_push(active, "a")
list_push(active, "a")
list_push(active, "new")
list_push(active, "new")
list_push(active, "")
haiku_cloud_morph(weights, frequency, last_used, sources, active, 10)
