# EXPECT: Haiku tokenizer piece limit is 10000 codepoints
IMPORT "../../../src/tokenizer.aml"
source = "▁"
cursor = 0
while cursor < 13:
    source = text_concat(source, source)
    cursor = cursor + 1
source = text_concat(source, text_slice(source, 0, 1809))
haiku_tokenizer_piece(source)
PRINT "HAIKU_INVALID_ACCEPTED"
