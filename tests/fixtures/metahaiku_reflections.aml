IMPORT "metahaiku_support.aml"
state = meta_test_new(1)
# Full Python reflection 1
user = ""
user = text_concat(user, "are you here")
spoken = ""
spoken = text_concat(spoken, "two voices\none field\nsoftly")
observation = zeros(4)
observation[0] = 0.75
observation[1] = 0.25
observation[2] = 0.125
observation[3] = 0.5
inner = haiku_meta_reflect(state, user, spoken, observation, 1)
wanted = ""
wanted = text_concat(wanted, "rain light cloud light dream\nrain light warm rain wind warm night\nwind moon night cloud moon")
assert(text_equal(inner, wanted), "Reflection generated text differs from Python")
assert(haiku_meta_check(state) == 1, "Reflection history count differs")
tape = record_get(state, "draws")
assert(tape[0] == 18, "Reflection complete draw order differs")
expected = list_new()
word = ""
word = text_concat(word, "two voices one field softly")
list_push(expected, word)
assert(text_equal(list_key(record_get(state, "meta_bootstrap")), list_key(expected)), "Reflection ordered-list reference differs")
expected = list_new()
word = ""
word = text_concat(word, "are you here")
list_push(expected, word)
word = ""
word = text_concat(word, "two voices\none field\nsoftly")
list_push(expected, word)
word = ""
word = text_concat(word, "rain light cloud light dream\nrain light warm rain wind warm night\nwind moon night cloud moon")
list_push(expected, word)
assert(text_equal(list_key(record_get(state, "meta_history")), list_key(expected)), "Reflection ordered-list reference differs")
metrics = record_get(state, "meta_metrics")
assert(metrics[0] == 1, "Reflection frozen context differs")
assert(metrics[1] == 0.75, "Reflection frozen context differs")
assert(metrics[2] == 0.25, "Reflection frozen context differs")
assert(metrics[3] == 0.125, "Reflection frozen context differs")
assert(metrics[4] == 0.5, "Reflection frozen context differs")
user = "changed caller"
spoken = "changed caller"
observation[0] = 1
# Full Python reflection 2
