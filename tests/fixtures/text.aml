# Source: harmonix abb878c52d763b73e5ad7a4d6a68a9ea7a248a39; coherence tolerance 0.000002.
IMPORT "../../src/text.aml"

def haiku_text_check(name, source, words, lines, coherence):
    errors = 0
    if haiku_word_count(source) != words:
        ECHO WORD_COUNT_MISMATCH
        errors = errors + 1
    if haiku_line_count(source) != lines:
        ECHO LINE_COUNT_MISMATCH
        errors = errors + 1
    actual_coherence = haiku_line_coherence(source)
    if actual_coherence != actual_coherence or abs(actual_coherence - coherence) > 0.000002:
        ECHO COHERENCE_MISMATCH
        errors = errors + 1
    if errors > 0:
        PRINT name
    return errors

def haiku_space_check(cp, expected):
    if haiku_space(cp) == expected:
        return 0
    ECHO SPACE_MISMATCH
    PRINT cp
    return 1

def haiku_line_check(name, source, index, expected):
    if text_equal(haiku_line(source, index), expected):
        return 0
    ECHO LINE_CONTENT_MISMATCH
    PRINT name
    return 1

