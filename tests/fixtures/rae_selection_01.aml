candidates = list_new()
piece = ""
piece = text_concat(piece, "words dance in cloud\nresonance finds its own path\nconstraint births form")
list_push(candidates, piece)
piece = ""
piece = text_concat(piece, "cloud cloud cloud\ncloud cloud cloud cloud\ncloud cloud cloud")
