assert(selected[0] == 0, "RAE winner differs")
haiku_rae_test_number(selected[1], 0.754614438282)
spoken = haiku_rae_reason(params, candidates, user, 0)
assert(text_equal(spoken, list_get(candidates, 0)), "RAE selected text differs")
PRINT "HAIKU_RAE_OK"
