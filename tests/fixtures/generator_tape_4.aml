# Direct pinned Python traces: tests/reference/generator_inputs.json.
# Generator cases: 4
# Result checks: 8
IMPORT "../../src/generator.aml"
# multiword_remainder (repair)
rows = list_new()
counts = map_new()
vocab = list_new()
syllables = map_new()
list_push(vocab, "a")
map_set(syllables, "a", 2)
list_push(vocab, "one")
map_set(syllables, "one", 1)
list_push(vocab, "big")
map_set(syllables, "big", 4)
tape = zeros(7)
tape[1] = 0
tape[2] = 0
tape[3] = 0.99
tape[4] = 0
tape[5] = 0
tape[6] = 0.9
rng = map_new()
map_set(rng, "scripted", 73)
actual = haiku_generate_line(rows, counts, vocab, syllables, 7, 1, rng, tape)
assert(text_equal(actual, "a a a one"), "multiword_remainder: line")
assert(tape[0] == 6, "multiword_remainder: consumed draws")
assert(map_len(rng) == 1 and map_get(rng, "scripted") == 73, "Scripted sampling changed rng")
# stranded_remainder (repair)
rows = list_new()
counts = map_new()
vocab = list_new()
syllables = map_new()
list_push(vocab, "a")
map_set(syllables, "a", 2)
list_push(vocab, "b")
map_set(syllables, "b", 3)
triple = list_new()
list_push(triple, "a")
list_push(triple, "a")
list_push(triple, "a")
haiku_chain_learn(rows, counts, vocab, triple)
map_set(counts, list_key(triple), 1)
tape = zeros(4)
tape[1] = 0
tape[2] = 0
tape[3] = 0
rng = map_new()
map_set(rng, "scripted", 73)
actual = haiku_generate_line(rows, counts, vocab, syllables, 5, 1, rng, tape)
assert(text_equal(actual, "a b"), "stranded_remainder: line")
assert(tape[0] == 3, "stranded_remainder: consumed draws")
assert(map_len(rng) == 1 and map_get(rng, "scripted") == 73, "Scripted sampling changed rng")
# initial_stranded_remainder (repair)
rows = list_new()
counts = map_new()
vocab = list_new()
syllables = map_new()
list_push(vocab, "a")
map_set(syllables, "a", 4)
list_push(vocab, "b")
map_set(syllables, "b", 2)
list_push(vocab, "c")
map_set(syllables, "c", 3)
tape = zeros(5)
tape[1] = 0
tape[2] = 0
tape[3] = 0
tape[4] = 0
rng = map_new()
map_set(rng, "scripted", 73)
actual = haiku_generate_line(rows, counts, vocab, syllables, 5, 1, rng, tape)
assert(text_equal(actual, "b c"), "initial_stranded_remainder: line")
assert(tape[0] == 4, "initial_stranded_remainder: consumed draws")
assert(map_len(rng) == 1 and map_get(rng, "scripted") == 73, "Scripted sampling changed rng")
# cold_temperature_stability (repair)
rows = list_new()
counts = map_new()
vocab = list_new()
syllables = map_new()
list_push(vocab, "a")
map_set(syllables, "a", 1)
list_push(vocab, "b")
map_set(syllables, "b", 1)
list_push(vocab, "x")
map_set(syllables, "x", 1)
list_push(vocab, "y")
map_set(syllables, "y", 1)
triple = list_new()
list_push(triple, "a")
list_push(triple, "b")
list_push(triple, "x")
haiku_chain_learn(rows, counts, vocab, triple)
map_set(counts, list_key(triple), 1)
triple = list_new()
list_push(triple, "a")
list_push(triple, "b")
list_push(triple, "y")
haiku_chain_learn(rows, counts, vocab, triple)
map_set(counts, list_key(triple), 3)
tape = zeros(3)
tape[1] = 0
tape[2] = 0.99
rng = map_new()
map_set(rng, "scripted", 73)
actual = haiku_generate_line(rows, counts, vocab, syllables, 2, 0.001, rng, tape)
assert(text_equal(actual, "a y"), "cold_temperature_stability: line")
assert(tape[0] == 2, "cold_temperature_stability: consumed draws")
assert(map_len(rng) == 1 and map_get(rng, "scripted") == 73, "Scripted sampling changed rng")
ECHO HAIKU_GENERATOR_OK
