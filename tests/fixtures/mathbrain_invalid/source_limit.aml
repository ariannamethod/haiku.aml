# EXPECT: Haiku MathBrain source limit is 10000 codepoints
IMPORT "../../../src/mathbrain.aml"
parameters = zeros(57)
state = haiku_mathbrain_state()
rows = list_new()
counts = map_new()
user = list_new()
rng = rng_new(42)
source = "one two three"
source = ""
cursor = 0
while cursor < 10000:
    source = text_concat(source, "x")
    cursor = cursor + 1
source = text_concat(source, "x")
# INVALID_CALL
haiku_mathbrain_observe(parameters, state, source, 0.7, rows, counts, user)
ECHO HAIKU_MATHBRAIN_INVALID_ACCEPTED
