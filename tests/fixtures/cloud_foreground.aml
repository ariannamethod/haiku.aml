observation = haiku_observe_trigrams(incoming, recent)
cloud_number_check("event 1 before", observation[0], 0.5)
cloud_number_check("event 1 before", observation[1], 0)
cloud_number_check("event 1 before", observation[2], 0)
cloud_number_check("event 1 before", observation[3], 0)
haiku_cloud_morph(weights, frequency, last_used, sources, active, 1)
