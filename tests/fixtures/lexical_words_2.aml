# Direct pinned Python references: tests/reference/lexical_inputs.json.
IMPORT "lexical_support.aml"
failures = 0
# leading_lf
source = "\none\ntwo\nthree"
expected = list_new()
list_push(expected, "one")
list_push(expected, "two")
list_push(expected, "three")
actual = haiku_words(source)
failures = failures + lexical_list_check("leading_lf", actual, expected)
# crlf
source = "one two\r\nthree\r\nfour five six"
expected = list_new()
list_push(expected, "one")
list_push(expected, "two")
list_push(expected, "three")
list_push(expected, "four")
list_push(expected, "five")
list_push(expected, "six")
actual = haiku_words(source)
failures = failures + lexical_list_check("crlf", actual, expected)
# cr_only
source = "one\rtwo\rthree"
expected = list_new()
list_push(expected, "one")
list_push(expected, "two")
list_push(expected, "three")
actual = haiku_words(source)
failures = failures + lexical_list_check("cr_only", actual, expected)
# mixed_crlf
source = "one\r\ntwo three\nfour\r"
expected = list_new()
list_push(expected, "one")
list_push(expected, "two")
list_push(expected, "three")
list_push(expected, "four")
actual = haiku_words(source)
failures = failures + lexical_list_check("mixed_crlf", actual, expected)
# tabs
source = "\tone\ttwo\nthree\t four\nfive\t"
expected = list_new()
list_push(expected, "one")
list_push(expected, "two")
list_push(expected, "three")
list_push(expected, "four")
list_push(expected, "five")
actual = haiku_words(source)
failures = failures + lexical_list_check("tabs", actual, expected)
# cyrillic
source = "сова рядом\nслова слушают ветер\nдруг здесь"
expected = list_new()
list_push(expected, "сова")
list_push(expected, "рядом")
