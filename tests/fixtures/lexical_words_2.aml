list_push(expected, "ветер")
list_push(expected, "друг")
list_push(expected, "здесь")
actual = haiku_words(source)
failures = failures + lexical_list_check("cyrillic", actual, expected)
# hebrew
source = "ינשוף כאן\nחבר מקשיב בשקט\nשתי עיניים"
