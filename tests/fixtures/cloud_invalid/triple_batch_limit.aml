# EXPECT: Haiku triple batch limit is 10000
IMPORT "../../../src/memory.aml"
weights = map_new()
frequency = map_new()
last_used = map_new()
observed_counts = map_new()
resonance = map_new()
counts = map_new()
sources = list_new()
observed = list_new()
edges = list_new()
vocab = list_new()
recent = list_new()
seeds = haiku_words("a b c")
haiku_cloud_seed(weights, frequency, last_used, sources, seeds, 0.25)
haiku_chain_seed(edges, counts, vocab, seeds)
incoming = haiku_trigrams(seeds)
haiku_store_trigrams(observed, observed_counts, resonance, incoming)
recent = list_clone(incoming)
incoming = list_new()
cursor = 0
while cursor < 10000:
    list_push(incoming, "a")
    list_push(incoming, "b")
    list_push(incoming, "c")
    cursor = cursor + 1
list_push(incoming, "a")
list_push(incoming, "b")
list_push(incoming, "c")
# INVALID_CALL
updated = haiku_chain_update(edges, counts, vocab, recent, incoming)
ECHO HAIKU_INVALID_ACCEPTED
