# Python reference: abb878c52d763b73e5ad7a4d6a68a9ea7a248a39
# Numeric reference values: 7
# List reference results: 10
IMPORT "cloud_support.aml"
observed = list_new()
edges = list_new()
vocab = list_new()
recent = list_new()
observed_counts = map_new()
resonance = map_new()
counts = map_new()
seeds = list_new()
haiku_chain_seed(edges, counts, vocab, seeds)
wanted = list_new()
cloud_list_check("empty seed observed", observed, wanted)
cloud_number_check("empty seed observer size", map_len(observed_counts), 0)
cloud_number_check("empty seed resonance size", map_len(resonance), 0)
wanted = list_new()
cloud_list_check("empty seed edges", edges, wanted)
cloud_number_check("empty seed edge size", map_len(counts), 0)
wanted = list_new()
cloud_list_check("empty seed vocab", vocab, wanted)
wanted = list_new()
cloud_list_check("empty seed recent", recent, wanted)
incoming = list_new()
haiku_store_trigrams(observed, observed_counts, resonance, incoming)
saved = list_clone(recent)
updated = haiku_chain_update(edges, counts, vocab, recent, incoming)
cloud_list_check("previous recent snapshot retained", recent, saved)
recent = updated
wanted = list_new()
cloud_list_check("empty event 0 observed", observed, wanted)
cloud_number_check("empty event 0 observer size", map_len(observed_counts), 0)
cloud_number_check("empty event 0 resonance size", map_len(resonance), 0)
wanted = list_new()
cloud_list_check("empty event 0 edges", edges, wanted)
cloud_number_check("empty event 0 edge size", map_len(counts), 0)
wanted = list_new()
cloud_list_check("empty event 0 vocab", vocab, wanted)
wanted = list_new()
cloud_list_check("empty event 0 recent", recent, wanted)
cloud_number_check("empty unknown transition", haiku_chain_count(counts, "absent-1", "absent-2", "absent-3"), 0)
wanted = list_new()
cloud_list_check("empty absent successors", haiku_chain_next(edges, "absent-1", "absent-2"), wanted)
ECHO HAIKU_CLOUD_PARITY_OK
