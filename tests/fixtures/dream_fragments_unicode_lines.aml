IMPORT "../../src/dream.aml"
state = record_new()
haiku_dream_init(state, list_new())
weights = zeros(1)
record_set(state, "dream_weights", weights)
source = ""
source = text_concat(source, " pluie \n\n облако \nשלום\t\n")
haiku_dream_fragments(state, source)
assert(list_len(record_get(state, "dream_fragments")) == 3, "Dream fragment count differs")
weights = record_get(state, "dream_weights")
item = ""
item = text_concat(item, "pluie")
assert(text_equal(list_get(record_get(state, "dream_fragments"), 0), item), "Dream fragment text differs")
assert(abs(weights[0] - 1.0) < 0.000002, "Dream fragment decay differs")
item = ""
item = text_concat(item, "облако")
assert(text_equal(list_get(record_get(state, "dream_fragments"), 1), item), "Dream fragment text differs")
assert(abs(weights[1] - 1.0) < 0.000002, "Dream fragment decay differs")
item = ""
item = text_concat(item, "שלום")
assert(text_equal(list_get(record_get(state, "dream_fragments"), 2), item), "Dream fragment text differs")
assert(abs(weights[2] - 1.0) < 0.000002, "Dream fragment decay differs")
source = ""
source = text_concat(source, "rain cloud\n \r\n")
haiku_dream_fragments(state, source)
assert(list_len(record_get(state, "dream_fragments")) == 4, "Dream fragment count differs")
weights = record_get(state, "dream_weights")
item = ""
item = text_concat(item, "pluie")
assert(text_equal(list_get(record_get(state, "dream_fragments"), 0), item), "Dream fragment text differs")
assert(abs(weights[0] - 0.95) < 0.000002, "Dream fragment decay differs")
item = ""
item = text_concat(item, "облако")
assert(text_equal(list_get(record_get(state, "dream_fragments"), 1), item), "Dream fragment text differs")
assert(abs(weights[1] - 0.95) < 0.000002, "Dream fragment decay differs")
item = ""
item = text_concat(item, "שלום")
assert(text_equal(list_get(record_get(state, "dream_fragments"), 2), item), "Dream fragment text differs")
assert(abs(weights[2] - 0.95) < 0.000002, "Dream fragment decay differs")
item = ""
item = text_concat(item, "rain cloud")
assert(text_equal(list_get(record_get(state, "dream_fragments"), 3), item), "Dream fragment text differs")
assert(abs(weights[3] - 1.0) < 0.000002, "Dream fragment decay differs")
source = ""
source = text_concat(source, "rain\nrain\nrain")
haiku_dream_fragments(state, source)
assert(list_len(record_get(state, "dream_fragments")) == 7, "Dream fragment count differs")
weights = record_get(state, "dream_weights")
item = ""
item = text_concat(item, "pluie")
assert(text_equal(list_get(record_get(state, "dream_fragments"), 0), item), "Dream fragment text differs")
assert(abs(weights[0] - 0.9025) < 0.000002, "Dream fragment decay differs")
item = ""
item = text_concat(item, "облако")
assert(text_equal(list_get(record_get(state, "dream_fragments"), 1), item), "Dream fragment text differs")
assert(abs(weights[1] - 0.9025) < 0.000002, "Dream fragment decay differs")
item = ""
item = text_concat(item, "שלום")
assert(text_equal(list_get(record_get(state, "dream_fragments"), 2), item), "Dream fragment text differs")
assert(abs(weights[2] - 0.9025) < 0.000002, "Dream fragment decay differs")
item = ""
item = text_concat(item, "rain cloud")
assert(text_equal(list_get(record_get(state, "dream_fragments"), 3), item), "Dream fragment text differs")
assert(abs(weights[3] - 0.95) < 0.000002, "Dream fragment decay differs")
item = ""
item = text_concat(item, "rain")
assert(text_equal(list_get(record_get(state, "dream_fragments"), 4), item), "Dream fragment text differs")
assert(abs(weights[4] - 1.0) < 0.000002, "Dream fragment decay differs")
item = ""
item = text_concat(item, "rain")
assert(text_equal(list_get(record_get(state, "dream_fragments"), 5), item), "Dream fragment text differs")
assert(abs(weights[5] - 1.0) < 0.000002, "Dream fragment decay differs")
item = ""
item = text_concat(item, "rain")
assert(text_equal(list_get(record_get(state, "dream_fragments"), 6), item), "Dream fragment text differs")
assert(abs(weights[6] - 1.0) < 0.000002, "Dream fragment decay differs")
haiku_dream_check(state)
PRINT "HAIKU_DREAM_OK"
