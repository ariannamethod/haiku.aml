IMPORT "lexical_support.aml"
failures = 0
# zero_width
source = "one​two\nthree‍four\nfive⁠six"
expected = list_new()
list_push(expected, "one​two")
list_push(expected, "three‍four")
list_push(expected, "five⁠six")
actual = haiku_words(source)
failures = failures + lexical_list_check("zero_width", actual, expected)
