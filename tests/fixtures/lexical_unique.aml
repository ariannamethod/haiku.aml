# Direct pinned Python references: tests/reference/lexical_inputs.json.
IMPORT "lexical_support.aml"
failures = 0
# empty
tokens = list_new()
expected = list_new()
actual = haiku_unique(tokens)
failures = failures + lexical_list_check("empty", actual, expected)
# one
tokens = list_new()
list_push(tokens, "one")
expected = list_new()
list_push(expected, "one")
actual = haiku_unique(tokens)
failures = failures + lexical_list_check("one", actual, expected)
# two
tokens = list_new()
list_push(tokens, "one")
list_push(tokens, "two")
expected = list_new()
list_push(expected, "one")
list_push(expected, "two")
actual = haiku_unique(tokens)
failures = failures + lexical_list_check("two", actual, expected)
# three
tokens = list_new()
list_push(tokens, "one")
list_push(tokens, "two")
list_push(tokens, "three")
expected = list_new()
list_push(expected, "one")
list_push(expected, "two")
list_push(expected, "three")
actual = haiku_unique(tokens)
failures = failures + lexical_list_check("three", actual, expected)
# five
tokens = list_new()
list_push(tokens, "one")
list_push(tokens, "two")
list_push(tokens, "three")
list_push(tokens, "four")
list_push(tokens, "five")
expected = list_new()
list_push(expected, "one")
list_push(expected, "two")
list_push(expected, "three")
list_push(expected, "four")
list_push(expected, "five")
actual = haiku_unique(tokens)
failures = failures + lexical_list_check("five", actual, expected)
# repeats
tokens = list_new()
list_push(tokens, "one")
list_push(tokens, "two")
list_push(tokens, "one")
list_push(tokens, "two")
list_push(tokens, "one")
expected = list_new()
list_push(expected, "one")
list_push(expected, "two")
actual = haiku_unique(tokens)
failures = failures + lexical_list_check("repeats", actual, expected)
# empty_strings
tokens = list_new()
list_push(tokens, "")
list_push(tokens, "a")
list_push(tokens, "")
list_push(tokens, "b")
list_push(tokens, "")
expected = list_new()
list_push(expected, "")
list_push(expected, "a")
list_push(expected, "b")
actual = haiku_unique(tokens)
failures = failures + lexical_list_check("empty_strings", actual, expected)
# multilingual
tokens = list_new()
list_push(tokens, "сова")
list_push(tokens, "ינשוף")
list_push(tokens, "été")
list_push(tokens, "🦉")
list_push(tokens, "друг")
expected = list_new()
list_push(expected, "сова")
list_push(expected, "ינשוף")
list_push(expected, "été")
list_push(expected, "🦉")
list_push(expected, "друг")
actual = haiku_unique(tokens)
failures = failures + lexical_list_check("multilingual", actual, expected)
# normalization
tokens = list_new()
list_push(tokens, "é")
list_push(tokens, "é")
list_push(tokens, "é")
list_push(tokens, "É")
expected = list_new()
list_push(expected, "é")
list_push(expected, "é")
list_push(expected, "É")
actual = haiku_unique(tokens)
failures = failures + lexical_list_check("normalization", actual, expected)
# embedded_spaces
tokens = list_new()
list_push(tokens, "a b")
list_push(tokens, "c")
list_push(tokens, "a")
list_push(tokens, "b c")
list_push(tokens, "d")
expected = list_new()
list_push(expected, "a b")
list_push(expected, "c")
list_push(expected, "a")
list_push(expected, "b c")
list_push(expected, "d")
actual = haiku_unique(tokens)
failures = failures + lexical_list_check("embedded_spaces", actual, expected)
# punctuation
tokens = list_new()
list_push(tokens, "#owl")
list_push(tokens, "a|b")
list_push(tokens, "\"friend\"")
list_push(tokens, "it's")
list_push(tokens, "\\")
expected = list_new()
list_push(expected, "#owl")
list_push(expected, "a|b")
list_push(expected, "\"friend\"")
list_push(expected, "it's")
list_push(expected, "\\")
actual = haiku_unique(tokens)
failures = failures + lexical_list_check("punctuation", actual, expected)
# newline
tokens = list_new()
list_push(tokens, "a\nb")
list_push(tokens, "c")
list_push(tokens, "d")
list_push(tokens, "a\nb")
expected = list_new()
list_push(expected, "a\nb")
list_push(expected, "c")
list_push(expected, "d")
actual = haiku_unique(tokens)
failures = failures + lexical_list_check("newline", actual, expected)
# Numeric reference values: 0
# List reference results: 12
if failures == 0:
    ECHO HAIKU_LEXICAL_PARITY_OK
else:
    ECHO HAIKU_LEXICAL_PARITY_FAIL
