# EXPECT: RAE context limit is 10000 entries
IMPORT "../rae_support.aml"
params = zeros(57)
state = haiku_rae_state()
user = list_new()
candidates = list_new()
list_push(candidates, "one\ntwo\nthree")
list_push(candidates, "rain\ncloud\nsky")
cursor = 0
while cursor < 3334:
    list_push(user, "x")
    list_push(user, "x")
    list_push(user, "x")
    cursor = cursor + 1
# INVALID_CALL
features = haiku_rae_features("one\ntwo\nthree", user)
PRINT "HAIKU_INVALID_ACCEPTED"
