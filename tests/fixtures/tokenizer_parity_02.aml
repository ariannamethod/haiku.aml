IMPORT "tokenizer_support.aml"
# Tokenizer references: 897
model = tokenizer_load("../../models/haiku_sp.model")
# german
source = ""
source = text_concat(source, "Straße ẞ SS")
actual = haiku_tokenize(source, "regex", model)
expected = list_new()
list_push(expected, "straße")
list_push(expected, "ß")
list_push(expected, "ss")
haiku_tokenizer_test_list(actual, expected, "german regex")
actual = haiku_trigrams(actual)
expected = list_new()
list_push(expected, "straße")
list_push(expected, "ß")
list_push(expected, "ss")
haiku_tokenizer_test_list(actual, expected, "german regex")
actual = haiku_tokenize(source, "sentencepiece", model)
expected = list_new()
list_push(expected, "str")
list_push(expected, "a")
list_push(expected, "ß")
list_push(expected, "e")
list_push(expected, "ß")
list_push(expected, "s")
list_push(expected, "s")
haiku_tokenizer_test_list(actual, expected, "german sentencepiece")
actual = haiku_trigrams(actual)
expected = list_new()
list_push(expected, "str")
list_push(expected, "a")
list_push(expected, "ß")
list_push(expected, "a")
list_push(expected, "ß")
list_push(expected, "e")
list_push(expected, "ß")
list_push(expected, "e")
list_push(expected, "ß")
list_push(expected, "e")
list_push(expected, "ß")
list_push(expected, "s")
list_push(expected, "ß")
list_push(expected, "s")
list_push(expected, "s")
haiku_tokenizer_test_list(actual, expected, "german sentencepiece")
actual = tokenizer_pieces(model, text_lower(source))
expected = list_new()
list_push(expected, "▁str")
list_push(expected, "a")
list_push(expected, "ß")
list_push(expected, "e")
list_push(expected, "▁")
list_push(expected, "ß")
list_push(expected, "▁s")
list_push(expected, "s")
haiku_tokenizer_test_list(actual, expected, "german native")
