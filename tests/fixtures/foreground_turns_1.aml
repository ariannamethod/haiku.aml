IMPORT "foreground_support.aml"
weights = map_new()
frequencies = map_new()
last_used = map_new()
observer_counts = map_new()
observer_resonance = map_new()
counts = map_new()
origins = list_new()
observer_rows = list_new()
rows = list_new()
vocab = list_new()
recent = list_new()
seed_source = ""
seed_source = text_concat(seed_source, "rain moon wind cloud rest warm dream night light sky word sun")
seeds = haiku_words(seed_source)
haiku_cloud_seed(weights, frequencies, last_used, origins, seeds, 0)
haiku_chain_seed(rows, counts, vocab, seeds)
syllables = haiku_syllable_cache(vocab)
voice_rng = rng_new(575)
draws = zeros(666)
cursor = 0
while cursor < 665:
    residue = cursor * 5 + 3
    residue = residue - floor(residue / 16) * 16
    draws[cursor + 1] = residue / 16
    cursor = cursor + 1
draws[0] = 0
mathbrain_state = haiku_mathbrain_state()
rae_state = haiku_rae_state()
turn = 0
mathbrain = zeros(57)
