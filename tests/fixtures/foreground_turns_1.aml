fg_near(temperatures[1], 0.29999999999999999)
fg_near(list_len(candidates), 5)
wanted_text = ""
wanted_text = text_concat(wanted_text, "wind rest sky moon warm\nsky sun rest light rain cloud night\nsun cloud dream word wind")
assert(text_equal(list_get(candidates, 0), wanted_text), "Foreground candidate/draw trace differs")
wanted_text = ""
wanted_text = text_concat(wanted_text, "dream light moon warm sky\nrain wind light rain cloud night sun\ncloud warm word wind dream")
assert(text_equal(list_get(candidates, 1), wanted_text), "Foreground candidate/draw trace differs")
