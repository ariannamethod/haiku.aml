assert(text_equal(list_get(candidates, 2), wanted_text), "Foreground candidate/draw trace differs")
wanted_text = ""
wanted_text = text_concat(wanted_text, "moon cloud sky rain rest\nlight word cloud night sun cloud dream\nword wind dream sky moon")
assert(text_equal(list_get(candidates, 3), wanted_text), "Foreground candidate/draw trace differs")
wanted_text = ""
wanted_text = text_concat(wanted_text, "warm night rain rest light\nrain wind night sun cloud dream word\nwind rest sky moon warm")
assert(text_equal(list_get(candidates, 4), wanted_text), "Foreground candidate/draw trace differs")
