# Direct pinned Python traces: tests/reference/generator_inputs.json.
# Generator cases: 6
# Result checks: 14
IMPORT "../../src/generator.aml"
# singleton_weighted (preserved)
rows = list_new()
counts = map_new()
vocab = list_new()
syllables = map_new()
list_push(vocab, "one")
map_set(syllables, "one", 1)
triple = list_new()
list_push(triple, "one")
list_push(triple, "one")
list_push(triple, "one")
haiku_chain_learn(rows, counts, vocab, triple)
map_set(counts, list_key(triple), 1)
tape = zeros(6)
tape[1] = 0
tape[2] = 0
tape[3] = 0
tape[4] = 0
tape[5] = 0
rng = map_new()
map_set(rng, "scripted", 73)
actual = haiku_generate_line(rows, counts, vocab, syllables, 5, 1, rng, tape)
assert(text_equal(actual, "one one one one one"), "singleton_weighted: line")
assert(tape[0] == 5, "singleton_weighted: consumed draws")
assert(map_len(rng) == 1 and map_get(rng, "scripted") == 73, "Scripted sampling changed rng")
