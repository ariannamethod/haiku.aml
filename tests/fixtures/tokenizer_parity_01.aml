IMPORT "tokenizer_support.aml"
# Tokenizer references: 1079
model = tokenizer_load("../../models/haiku_sp.model")
# empty
source = ""
actual = haiku_tokenize(source, "regex", model)
expected = list_new()
haiku_tokenizer_test_list(actual, expected, "empty regex")
actual = haiku_trigrams(actual)
expected = list_new()
haiku_tokenizer_test_list(actual, expected, "empty regex")
actual = haiku_tokenize(source, "sentencepiece", model)
expected = list_new()
haiku_tokenizer_test_list(actual, expected, "empty sentencepiece")
actual = haiku_trigrams(actual)
expected = list_new()
haiku_tokenizer_test_list(actual, expected, "empty sentencepiece")
actual = tokenizer_pieces(model, text_lower(source))
expected = list_new()
haiku_tokenizer_test_list(actual, expected, "empty native")
# whitespace
source = ""
source = text_concat(source, "   ")
actual = haiku_tokenize(source, "regex", model)
expected = list_new()
haiku_tokenizer_test_list(actual, expected, "whitespace regex")
actual = haiku_trigrams(actual)
expected = list_new()
haiku_tokenizer_test_list(actual, expected, "whitespace regex")
actual = haiku_tokenize(source, "sentencepiece", model)
expected = list_new()
haiku_tokenizer_test_list(actual, expected, "whitespace sentencepiece")
actual = haiku_trigrams(actual)
expected = list_new()
haiku_tokenizer_test_list(actual, expected, "whitespace sentencepiece")
actual = tokenizer_pieces(model, text_lower(source))
expected = list_new()
haiku_tokenizer_test_list(actual, expected, "whitespace native")
# newlines
source = ""
source = text_concat(source, "\t\n\r")
source = text_concat(source, text_from_codepoint(11))
source = text_concat(source, text_from_codepoint(12))
actual = haiku_tokenize(source, "regex", model)
expected = list_new()
haiku_tokenizer_test_list(actual, expected, "newlines regex")
actual = haiku_trigrams(actual)
expected = list_new()
haiku_tokenizer_test_list(actual, expected, "newlines regex")
actual = haiku_tokenize(source, "sentencepiece", model)
expected = list_new()
piece = ""
piece = text_concat(piece, "\t\n\r")
piece = text_concat(piece, text_from_codepoint(11))
piece = text_concat(piece, text_from_codepoint(12))
list_push(expected, piece)
haiku_tokenizer_test_list(actual, expected, "newlines sentencepiece")
actual = haiku_trigrams(actual)
expected = list_new()
haiku_tokenizer_test_list(actual, expected, "newlines sentencepiece")
actual = tokenizer_pieces(model, text_lower(source))
expected = list_new()
list_push(expected, "▁")
piece = ""
piece = text_concat(piece, "\t\n\r")
piece = text_concat(piece, text_from_codepoint(11))
piece = text_concat(piece, text_from_codepoint(12))
list_push(expected, piece)
haiku_tokenizer_test_list(actual, expected, "newlines native")
