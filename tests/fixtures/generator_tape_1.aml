# Direct pinned Python traces: tests/reference/generator_inputs.json.
# Generator cases: 6
# Result checks: 12
IMPORT "../../src/generator.aml"
# first_key_skips_middle (preserved)
rows = list_new()
counts = map_new()
vocab = list_new()
syllables = map_new()
list_push(vocab, "a")
map_set(syllables, "a", 1)
list_push(vocab, "b")
map_set(syllables, "b", 1)
list_push(vocab, "c")
map_set(syllables, "c", 1)
list_push(vocab, "d")
map_set(syllables, "d", 1)
list_push(vocab, "e")
map_set(syllables, "e", 1)
list_push(vocab, "f")
map_set(syllables, "f", 1)
triple = list_new()
list_push(triple, "a")
list_push(triple, "b")
list_push(triple, "c")
haiku_chain_learn(rows, counts, vocab, triple)
map_set(counts, list_key(triple), 1)
triple = list_new()
list_push(triple, "a")
list_push(triple, "d")
list_push(triple, "e")
haiku_chain_learn(rows, counts, vocab, triple)
map_set(counts, list_key(triple), 9)
triple = list_new()
list_push(triple, "a")
list_push(triple, "c")
list_push(triple, "f")
haiku_chain_learn(rows, counts, vocab, triple)
map_set(counts, list_key(triple), 1)
tape = zeros(4)
tape[1] = 0
tape[2] = 0.25
tape[3] = 0.75
rng = map_new()
map_set(rng, "scripted", 73)
actual = haiku_generate_line(rows, counts, vocab, syllables, 3, 1, rng, tape)
assert(text_equal(actual, "a c f"), "first_key_skips_middle: line")
assert(tape[0] == 3, "first_key_skips_middle: consumed draws")
assert(map_len(rng) == 1 and map_get(rng, "scripted") == 73, "Scripted sampling changed rng")
