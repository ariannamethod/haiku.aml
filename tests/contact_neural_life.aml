IMPORT "../src/parliament_contact.aml"

def neural_fixture_new(owner, enabled):
    state = haiku_contact_enable_learning(haiku_contact_new(owner, 42))
    state = haiku_contact_enable_symbols(state, 1, 0)
    state = haiku_contact_enable_exchange(state, 0, 0, 0)
    state = haiku_contact_enable_concepts(state, 2)
    return haiku_contact_enable_neural(state, enabled)

def neural_fixture_event(owner, source, number, turn):
    event = haiku_contact_event("human", source, "en", [0.5, 0.5, 1, 0.5], [0], 0.5, 0, number, turn)
    if text_equal(owner, "friend"):
        native = haiku_contact_event("haiku", source, "en", [0.5, 0.5, 1, 0.5], [0], 0.5, 7, number, turn)
        event = haiku_contact_derive(native, "friend", source, 6, number, turn)
    return event

# Context and numerical policy controls do not need a provider.
assert(record_get(haiku_contact_neural_window(haiku_words("stream rain"), 0), "eligible"), "Sparse reviewed window was not eligible")
assert(record_get(haiku_contact_neural_window(haiku_words("stream rain fire"), 0), "eligible") == 0, "Unsupported second teacher was hidden")
assert(record_get(haiku_contact_neural_window(haiku_words("stream rain river"), 0), "eligible") == 0, "Two reviewed spellings entered the sparse learner")
assert(record_get(haiku_contact_neural_window(haiku_words("stream rain stream"), 0), "eligible") == 0, "Repeated target hid a second occurrence")
assert(record_get(haiku_contact_neural_window(haiku_words("stream fire"), 0), "eligible") == 0, "Unsupported teacher entered model centres")
assert(haiku_contact_neural_verdict([0.6, 0.3, 0.2, 0.1], [0.4, 0.3, 0.2, 0.1], 0.5, 0) == 1, "Independent scalar support differs")
assert(haiku_contact_neural_verdict([0.6, 0.6, 0.2, 0.1], [0.4, 0.4, 0.2, 0.1], 0.5, 0) == 2, "Tied model centres supported a binding")
assert(haiku_contact_neural_verdict([-0.1, -0.3, -0.4, -0.5], [-0.1, -0.3, -0.4, -0.5], 0.5, 0) == 2, "Negative best model centre supported a binding")
assert(haiku_contact_neural_verdict([0.6, 0.595, 0.2, 0.1], [0.6, 0.595, 0.2, 0.1], 0.5, 0) == 2, "Insufficient model margin supported a binding")
assert(haiku_contact_neural_verdict([0.6, 0.3, 0.2, 0.1], [0.4, 0.3, 0.2, 0.1], 0.5, 4) == 2, "Model disagreement ignored local teacher")

a = model_try_load("../weights/haiku1.gguf")
b = model_try_load("../weights/haiku2.gguf")
absent = model_try_load("fixtures/neural-intentionally-absent.gguf")
assert(model_ready(a) and model_ready(b) and model_ready(absent) == 0, "Neural fixture sources differ")
state = neural_fixture_new("haiku", 1)
off = neural_fixture_new("haiku", 0)
original = record_clone(state)
assert(record_equal(state, haiku_contact_enable_neural(state, 0)), "Repeated neural activation changed its saved mode")
assert(list_len(record_keys(state)) == 65, "Neural contact schema differs")
first = neural_fixture_event("haiku", "stream rain", 1, 1)
haiku_contact_publish(off, first)
quiet = record_clone(off)
receipt = haiku_contact_neural_observe(off, first, a, b)
assert(record_get(receipt, "forwards") == 0 and record_equal(off, quiet), "Disabled neural observer changed its owner")
haiku_contact_publish(state, first)
quiet = record_clone(state)
receipt = haiku_contact_neural_observe(state, first, absent, absent)
assert(record_get(receipt, "forwards") == 0 and record_equal(state, quiet), "Missing bodies changed neural state or bank")
assert(haiku_contact_neural_audit(state, absent, absent) == 0, "Missing source audit forwarded")
receipt = haiku_contact_neural_observe(state, first, a, b)
assert(record_get(receipt, "observed") == 1 and record_get(receipt, "forwards") == 44, "Cold neural observation budget differs")
quiet = record_clone(state)
receipt = haiku_contact_neural_observe(state, first, a, b)
assert(record_get(receipt, "forwards") == 0 and record_equal(state, quiet), "Repeated neural observation changed the owner")
haiku_contact_concepts_finish(state)
haiku_contact_save(state, text_concat(neural_test_prefix, "first"))
unbound = haiku_contact_neural_lookup(state, "en", "stream")
assert(unbound[0] == -1, "One neural context promoted a word")

second = neural_fixture_event("haiku", "stream river", 2, 2)
haiku_contact_publish(state, second)
receipt = haiku_contact_neural_observe(state, second, a, b)
assert(record_get(receipt, "observed") == 1 and record_get(receipt, "forwards") == 2, "Warm neural observation budget differs")
haiku_contact_concepts_finish(state)
third = neural_fixture_event("haiku", "stream ocean", 3, 3)
haiku_contact_publish(state, third)
receipt = haiku_contact_neural_observe(state, third, a, b)
haiku_contact_concepts_finish(state)
learned = haiku_contact_learning_lookup(state, "en", "stream")
assert(learned[0] == 0 and learned[1] == 0.25, "Three model-supported sparse encounters did not bind stream to water")
assert(list_find(record_get(state, "learn_words"), "stream") < 0, "Ordinary two-teacher learner supplied sparse binding")
glyphs = haiku_contact_glyphs(state, "stream", "en")
assert(glyphs[0] == 0.2, "Neural binding did not reach contact glyphs")
rank = haiku_contact_rank(state, haiku_words("stream"), [0], "en")
field = record_get(state, "p:field")
assert(abs(rank[0] - 0.15 * 0.25 * field[0]) < 0.000001 and abs(rank[0]) > 0, "Neural binding did not change word ranking")
symbols = record_get(state, "symbol_rows")
assert(symbols[2 * 139 + 11] == -1, "Confirming encounter rewrote its own frozen glyph path")
assert(haiku_contact_neural_audit(state, a, b) == 48, "Neural resume audit budget differs")
assert(haiku_contact_neural_audit(state, a, absent) == 24, "A-only audit rewrote historical mixture")
assert(haiku_contact_neural_audit(state, absent, b) == 24, "B-only audit rewrote historical mixture")
haiku_contact_save(state, text_concat(neural_test_prefix, "bound"))
resumed = haiku_contact_load(text_concat(neural_test_prefix, "bound"))
assert(record_equal(state, resumed), "Neural checkpoint lost evidence")
assert(haiku_contact_neural_audit(resumed, absent, absent) == 0, "Weightless resumed audit changed history")

# Canonical set dedupe, same-turn delivery and private ownership.
duplicate = neural_fixture_event("haiku", "RAIN stream", 4, 4)
haiku_contact_publish(state, duplicate)
receipt = haiku_contact_neural_observe(state, duplicate, a, b)
assert(record_get(receipt, "duplicates") == 1 and record_get(receipt, "forwards") == 0, "Reordered old context counted again")
haiku_contact_concepts_finish(state)
haiku_contact_publish(resumed, duplicate)
haiku_contact_neural_observe(resumed, duplicate, a, b)
haiku_contact_concepts_finish(resumed)
assert(record_equal(state, resumed), "Neural restart continuation differs")
symbols = record_get(state, "symbol_rows")
assert(symbols[3 * 139 + 12] == 0, "Later encounter did not use remembered neural binding")
haiku_contact_save(state, text_concat(neural_test_prefix, "full"))
haiku_contact_save(resumed, text_concat(neural_test_prefix, "resumed"))
friend = neural_fixture_new("friend", 1)
friend_original = record_clone(friend)
unbound = haiku_contact_learning_lookup(friend, "en", "stream")
assert(unbound[0] == -1 and record_equal(friend, friend_original), "Haiku binding leaked to friend")
peer = neural_fixture_event("friend", "stream rain", 10, 1)
haiku_contact_publish(friend, peer)
receipt = haiku_contact_neural_observe(friend, peer, a, b)
assert(record_get(receipt, "observed") == 1, "Delivered peer did not teach its own neural owner")
peer = neural_fixture_event("friend", "stream river", 11, 1)
haiku_contact_publish(friend, peer)
receipt = haiku_contact_neural_observe(friend, peer, a, b)
assert(record_get(receipt, "duplicates") == 1 and record_get(receipt, "forwards") == 0, "Two peer deliveries in one turn made two votes")
haiku_contact_concepts_finish(friend)
haiku_contact_save(friend, text_concat(neural_test_prefix, "friend"))

# Two later conflicting contexts revoke the existing three-context majority.
conflict = neural_fixture_event("haiku", "stream tree", 5, 5)
haiku_contact_publish(state, conflict)
haiku_contact_neural_observe(state, conflict, a, b)
haiku_contact_concepts_finish(state)
conflict = neural_fixture_event("haiku", "stream forest", 6, 6)
haiku_contact_publish(state, conflict)
haiku_contact_neural_observe(state, conflict, a, b)
haiku_contact_concepts_finish(state)
unbound = haiku_contact_learning_lookup(state, "en", "stream")
assert(unbound[0] == -1, "Conflicting external model contexts did not revoke binding")
haiku_contact_save(state, text_concat(neural_test_prefix, "conflict"))

# Explicit reviewed choices keep authority over a retained neural association.
manual = haiku_contact_load(text_concat(neural_test_prefix, "bound"))
haiku_contact_bind(manual, "en", "stream", 82, 0, 3)
known = haiku_contact_learning_lookup(manual, "en", "stream")
assert(known[0] == 82 and known[1] == 1, "Neural association overrode reviewed binding")
assert(record_equal(original, neural_fixture_new("haiku", 1)), "Neural upgrade mutated its input")
PRINT "HAIKU_CONTACT_NEURAL_OK"
