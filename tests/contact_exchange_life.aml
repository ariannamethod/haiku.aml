IMPORT "contact_exchange_fixture.aml"

sender = haiku_contact_load(text_concat(exchange_fixture_prefix, "donor"))
receiver = haiku_contact_load(text_concat(exchange_fixture_prefix, "receiver"))
native = exchange_fixture_native("haiku", "fire water tree", 100, 43)
sender_before = record_clone(sender)
packet = haiku_contact_exchange_offer(sender, native)
assert(record_equal(sender_before, sender), "Offering a structure changed the predecessor or RNG")
assert(record_get(packet, "available") == 1 and record_get(packet, "count") == 2, "Nested offer omitted its complete parent closure")
assert(text_equal(record_get(packet, "root"), "((fire+water)+tree)"), "Offered root lost its ordered structure")
tree = record_get(packet, "tree")
assert(len(tree) == 60 and tree[0] == 1 and tree[1] == 0 and tree[4] == 88 and tree[5] == 4, "Offer did not use packet-local parent references")
assert(tree[2] == 0 and tree[3] == 0 and tree[6] == 0 and tree[7] == 0, "A locally born offer acquired foreign ancestry")
peer = exchange_fixture_deliver(sender, receiver, "fire water tree", 100, 43)
exchange_fixture_dream(receiver, 2, 43)
before_adoption = record_clone(receiver)
haiku_contact_save(before_adoption, text_concat(exchange_test_prefix, "pre-adopt"))
checkpoint_save(packet, text_concat(exchange_test_prefix, "packet"))
checkpoint_save(peer, text_concat(exchange_test_prefix, "peer"))
result = haiku_contact_exchange_recv(receiver, peer, packet, 2)
assert(record_get(result, "status") == 3 and record_get(result, "adopted") == 2 and record_get(result, "root") == 90, "Nested closure was not adopted into private slots")
clock = record_get(receiver, "symbol_clock")
old_clock = record_get(before_adoption, "symbol_clock")
assert(clock[8] == 3 and clock[32] == old_clock[32] and clock[26] == 0, "Adoption manufactured external observations")
assert(record_equal(exchange_fixture_leaf(receiver, "symbol_rows"), exchange_fixture_leaf(before_adoption, "symbol_rows")), "Adoption copied foreign proof rows")
assert(record_equal(exchange_fixture_leaf(receiver, "symbol_text"), exchange_fixture_leaf(before_adoption, "symbol_text")), "Adoption copied foreign witness text")
assert(text_equal(haiku_contact_symbol_name(receiver, 88), "(tree+light)"), "Adoption replaced an independently lived node")
assert(text_equal(haiku_contact_symbol_name(receiver, 89), haiku_contact_symbol_name(sender_before, 88)), "Private local IDs changed the first canonical identity")
assert(text_equal(haiku_contact_symbol_name(receiver, 90), haiku_contact_symbol_name(sender_before, 89)), "Private local IDs changed the nested canonical identity")
nodes = record_get(receiver, "symbol_nodes")
assert(nodes[10] == 1 and nodes[11] == 0 and nodes[20] == 89 and nodes[21] == 4, "Adopted parents were not resolved in the receiver")
i = 1
while i <= 2:
    row = i * 10
    assert(nodes[row + 4] == 43 and nodes[row + 5] == 2, "Adopted closure lost its actual acquisition boundary")
    assert(nodes[row + 6] == 0 and nodes[row + 8] == 0 and nodes[row + 9] == 0, "Adoption invented fourteen local witnesses")
    i = i + 1
origins = record_get(receiver, "exchange_origin")
assert(origins[0] == 0 and origins[1] == 0 and origins[2] == 0, "A native node lost its origin")
assert(origins[3] == 1 and origins[4] == 0 and origins[5] == 0, "First adopted parent lost its first receipt")
assert(origins[6] == 1 and origins[7] == 0 and origins[8] == 1, "Nested adopted node lost its packet position")
exchange = record_get(receiver, "exchange_clock")
assert(exchange[4] == 100 and exchange[5] == 43 and exchange[6] == 1 and exchange[7] == 1 and exchange[8] == 2, "First exchange cursor differs")
rows = record_get(receiver, "exchange_rows")
assert(rows[0] == 100 and rows[1] == 43 and rows[2] == 2, "Exchange receipt lost the actual delivered event")
assert(rows[3] == record_get(packet, "sender_revision") and rows[4] == 28 and rows[5] == 2, "Exchange receipt lost the sender's earlier boundary")
assert(rows[6] == 2 and rows[7] == 0 and rows[8] == 3 and rows[9] == 3, "Exchange receipt lost its matched text span")
assert(rows[10] == 1 and rows[11] == 2 and rows[12] == 1 and rows[13] == clock[5], "Exchange receipt lost its private allocation")
i = 0
while i < 60:
    assert(rows[14 + i] == tree[i], "Exchange receipt changed its frozen packet tree")
    i = i + 1
texts = record_get(receiver, "exchange_text")
assert(text_equal(list_get(texts, 0), "fire water tree") and text_equal(list_get(texts, 1), "en"), "Exchange receipt lost its exact text or language")
assert(text_equal(list_get(texts, 2), "haiku") and text_equal(list_get(texts, 3), "((fire+water)+tree)"), "Exchange receipt lost its sender or canonical root")
haiku_contact_save(receiver, text_concat(exchange_test_prefix, "adopted"))

# Received nodes first affect later turns. The queries themselves are pure.
before_queries = record_clone(receiver)
path = haiku_contact_symbols_path(receiver, "fire water tree", "en", 43)
parsed = record_get(path, "parsed")
assert(len(parsed) == 3 and parsed[0] == 1 and parsed[1] == 0 and parsed[2] == 4, "Adoption rewrote its own delivery turn")
path = haiku_contact_symbols_path(receiver, "fire water tree", "en", 44)
parsed = record_get(path, "parsed")
assert(len(parsed) == 1 and parsed[0] == 90, "Future text did not recognize the received recursive structure")
projection = haiku_contact_symbol_pressure(receiver, "fire water", "en", 43)
assert(projection[4] == 0, "A received node exerted pressure on its acquisition turn")
projection = haiku_contact_symbol_pressure(receiver, "fire water", "en", 44)
assert(projection[4] == 0.25, "A received structure did not exert the shared bounded pressure")
assert(record_equal(before_queries, receiver), "Recognition or pressure changed owned memory or RNG")
replay_before = record_clone(receiver)
haiku_contact_exchange_recv(receiver, peer, packet, 2)
echo = record_clone(peer)
record_set(echo, "replay", 1)
haiku_contact_exchange_recv(receiver, echo, packet, 2)
assert(record_equal(replay_before, receiver), "Repeated delivery or internal replay changed the adopted owner")

# A later exact structure reuses the existing IDs and immutable first receipt.
reused_sender = record_clone(sender)
reused = record_clone(receiver)
again_native = exchange_fixture_native("haiku", "fire water tree", 101, 44)
again_packet = haiku_contact_exchange_offer(reused_sender, again_native)
again_peer = exchange_fixture_deliver(reused_sender, reused, "fire water tree", 101, 44)
exchange_fixture_dream(reused, 3, 44)
first_origin = exchange_fixture_leaf(reused, "exchange_origin")
first_rows = exchange_fixture_leaf(reused, "exchange_rows")
first_text = exchange_fixture_leaf(reused, "exchange_text")
result = haiku_contact_exchange_recv(reused, again_peer, again_packet, 3)
assert(record_get(result, "status") == 2 and record_get(result, "adopted") == 0 and record_get(result, "root") == 90, "Known structure allocated another private node")
assert(record_equal(first_origin, exchange_fixture_leaf(reused, "exchange_origin")), "Canonical reuse replaced first origin")
assert(record_equal(first_rows, exchange_fixture_leaf(reused, "exchange_rows")) and record_equal(first_text, exchange_fixture_leaf(reused, "exchange_text")), "Canonical reuse rewrote the first receipt")
haiku_contact_save(reused, text_concat(exchange_test_prefix, "reused"))

# Source counters are independent. First hearing was peer6/event100; a later
# own native7/event44 legitimately re-exports that structure with event100
# retained as its foreign identity. No cross-source numeric ordering exists.
return_sender = record_clone(receiver)
return_receiver = record_clone(sender)
same_turn_native = exchange_fixture_native("friend", "fire water tree", 44, 43)
same_turn_offer = haiku_contact_exchange_offer(return_sender, same_turn_native)
assert(record_get(same_turn_offer, "available") == 0, "A received node was exported in its own acquisition turn")
return_native = exchange_fixture_native("friend", "fire water tree", 44, 44)
return_packet = haiku_contact_exchange_offer(return_sender, return_native)
tree = record_get(return_packet, "tree")
assert(record_get(return_packet, "available") == 1 and record_get(return_packet, "event") == 44, "A legitimate received structure could not be re-exported")
assert(tree[2] == 1 and tree[3] == 100 and tree[6] == 1 and tree[7] == 100, "Re-export lost the independent first-hearing identity")
return_peer = exchange_fixture_deliver(return_sender, return_receiver, "fire water tree", 44, 44)
exchange_fixture_dream(return_receiver, 3, 44)
return_origins = exchange_fixture_leaf(return_receiver, "exchange_origin")
result = haiku_contact_exchange_recv(return_receiver, return_peer, return_packet, 3)
assert(record_get(result, "status") == 2 and record_get(result, "root") == 89, "Returning canonical structure did not reuse the native identity")
assert(record_equal(return_origins, exchange_fixture_leaf(return_receiver, "exchange_origin")), "An echo laundered native origin into foreign history")
haiku_contact_save(return_receiver, text_concat(exchange_test_prefix, "returned"))

# A received C can parent a locally earned child. All fourteen proofs below
# are new delivered encounters, after acquisition, with C present in their
# original compressed paths. No donor proof or retrospective scan is used.
i = 1
while i <= 13:
    own_peer = exchange_fixture_deliver(sender, receiver, "fire water tree music", 100 + i, 43 + i)
    clock = record_get(receiver, "symbol_clock")
    rows = record_get(receiver, "symbol_rows")
    row = clock[9] * 139
    assert(rows[row + 10] == 2 and rows[row + 75] == 90 and rows[row + 76] == 82, "Own child evidence lost the already received parent")
    i = i + 1
exchange_fixture_dream(receiver, 3, 56)
clock = record_get(receiver, "symbol_clock")
assert(clock[8] == 3, "Thirteen new own turns created a child")
haiku_contact_save(receiver, text_concat(exchange_test_prefix, "thirteen"))
resumed = haiku_contact_load(text_concat(exchange_test_prefix, "thirteen"))
own_peer = exchange_fixture_deliver(sender, receiver, "fire water tree music", 114, 57)
haiku_contact_publish(resumed, own_peer)
clock = record_get(receiver, "symbol_clock")
assert(clock[8] == 3, "The fourteenth waking encounter itself created a child")
exchange_fixture_dream(receiver, 4, 57)
exchange_fixture_dream(resumed, 4, 57)
assert(record_equal(receiver, resumed), "Restart changed own child formation")
clock = record_get(receiver, "symbol_clock")
nodes = record_get(receiver, "symbol_nodes")
origins = record_get(receiver, "exchange_origin")
assert(clock[8] == 4 and nodes[30] == 90 and nodes[31] == 82, "Fourteen new own encounters did not form C plus music")
assert(nodes[34] == 57 and nodes[35] == 4 and nodes[36] == 44 and nodes[38] == 14 and nodes[39] == 14, "Local child borrowed an incoming proof boundary")
assert(origins[9] == 0 and origins[10] == 0 and origins[11] == 0, "Locally earned child was marked as adopted")
assert(text_equal(haiku_contact_symbol_name(receiver, 91), "(((fire+water)+tree)+music)"), "Local child lost its recursive ordered identity")
rows = record_get(receiver, "symbol_rows")
texts = record_get(receiver, "symbol_text")
i = 0
while i < 14:
    row = (128 + 3 * 14 + i) * 139
    assert(rows[row] == 6 and rows[row + 1] == 101 + i and rows[row + 2] == 44 + i, "Own child proof did not retain a fresh delivered event")
    assert(rows[row + 3] == 7 and rows[row + 4] == 101 + i and rows[row + 5] == 7 and rows[row + 6] == 101 + i, "Own child proof laundered its source ancestry")
    assert(rows[row + 10] == 2 and rows[row + 75] == 90 and rows[row + 76] == 82, "Own child proof was reinterpreted after formation")
    assert(text_equal(list_get(texts, (128 + 3 * 14 + i) * 4), "fire water tree music"), "Own child proof lost exact text")
    i = i + 1
last_peer = exchange_fixture_deliver(sender, receiver, "fire water tree", 115, 58)
haiku_contact_publish(resumed, last_peer)
before_queries = record_clone(receiver)
projection = haiku_contact_symbol_pressure(receiver, "fire water tree", "en", 58)
assert(projection[82] == 0.25, "A later context did not feel its locally earned child")
words = haiku_words("music tree water")
scores = haiku_contact_rank(receiver, words, [1, 1, 1], "en")
field = record_get(receiver, "p:field")
assert(abs(scores[0] - (1 + 0.15 * field[82] + 0.0375)) < 0.000001, "Own child word pressure exceeded or lost its fixed bound")
assert(abs(scores[1] - (1 + 0.15 * field[4])) < 0.000001 and abs(scores[2] - (1 + 0.15 * field[0])) < 0.000001, "Shorter received parents overruled the longest context")
assert(record_equal(before_queries, receiver) and record_equal(receiver, resumed), "Pure rank or restart changed an owned leaf")
haiku_contact_save(receiver, text_concat(exchange_test_prefix, "child"))
haiku_contact_save(resumed, text_concat(exchange_test_prefix, "resumed"))

# Fill a separate receiver with fourteen genuine offers. It already owns one
# unrelated native node, leaving exactly one free slot for a two-node closure.
capacity_sender = haiku_contact_load(text_concat(exchange_fixture_prefix, "capacity-sender"))
capacity = haiku_contact_load(text_concat(exchange_fixture_prefix, "receiver"))
anchors = haiku_contact_anchors()
i = 2
while i < 16:
    text = text_concat(list_get(anchors, i), " music")
    native = exchange_fixture_native("haiku", text, 498 + i, 41 + i)
    packet = haiku_contact_exchange_offer(capacity_sender, native)
    assert(record_get(packet, "available") == 1 and record_get(packet, "count") == 1, "Prepared capacity offer was not a single lived node")
    peer = exchange_fixture_deliver(capacity_sender, capacity, text, 498 + i, 41 + i)
    exchange_fixture_dream(capacity, i, 41 + i)
    result = haiku_contact_exchange_recv(capacity, peer, packet, i)
    assert(record_get(result, "status") == 3 and record_get(result, "adopted") == 1, "Capacity preparation did not receive one real node")
    i = i + 1
clock = record_get(capacity, "symbol_clock")
assert(clock[8] == 15, "Capacity setup did not leave one slot")
native = exchange_fixture_native("haiku", "fire water tree", 514, 57)
packet = haiku_contact_exchange_offer(capacity_sender, native)
peer = exchange_fixture_deliver(capacity_sender, capacity, "fire water tree", 514, 57)
exchange_fixture_dream(capacity, 16, 57)
before_capacity = record_clone(capacity)
result = haiku_contact_exchange_recv(capacity, peer, packet, 16)
assert(record_get(result, "status") == 4 and record_get(result, "adopted") == 0, "Insufficient capacity partially accepted a closure")
names = haiku_words("symbol_clock symbol_nodes symbol_rows symbol_text exchange_origin exchange_rows exchange_text")
i = 0
while i < list_len(names):
    name = list_get(names, i)
    assert(record_equal(exchange_fixture_leaf(before_capacity, name), exchange_fixture_leaf(capacity, name)), "Capacity refusal left an orphan parent or rewrote history")
    i = i + 1
exchange = record_get(capacity, "exchange_clock")
assert(exchange[4] == 514 and exchange[7] == 14, "Capacity refusal lost its consumed delivery clock")

# A single parent fits the remaining slot. The full receiver still recognizes
# known structures and preserves their original receipt.
native = exchange_fixture_native("haiku", "fire water", 515, 58)
packet = haiku_contact_exchange_offer(capacity_sender, native)
peer = exchange_fixture_deliver(capacity_sender, capacity, "fire water", 515, 58)
exchange_fixture_dream(capacity, 17, 58)
result = haiku_contact_exchange_recv(capacity, peer, packet, 17)
assert(record_get(result, "status") == 3 and record_get(result, "root") == 103, "The last slot was not available after atomic refusal")
native = exchange_fixture_native("haiku", "fire water tree", 516, 59)
packet = haiku_contact_exchange_offer(capacity_sender, native)
peer = exchange_fixture_deliver(capacity_sender, capacity, "fire water tree", 516, 59)
exchange_fixture_dream(capacity, 18, 59)
result = haiku_contact_exchange_recv(capacity, peer, packet, 18)
assert(record_get(result, "status") == 4 and record_get(result, "adopted") == 0, "Full capacity adopted a missing recursive child")
native = exchange_fixture_native("haiku", "fire water", 517, 60)
packet = haiku_contact_exchange_offer(capacity_sender, native)
peer = exchange_fixture_deliver(capacity_sender, capacity, "fire water", 517, 60)
exchange_fixture_dream(capacity, 19, 60)
first_origin = exchange_fixture_leaf(capacity, "exchange_origin")
first_rows = exchange_fixture_leaf(capacity, "exchange_rows")
result = haiku_contact_exchange_recv(capacity, peer, packet, 19)
assert(record_get(result, "status") == 2 and record_get(result, "root") == 103, "Full capacity could not reuse an existing structure")
assert(record_equal(first_origin, exchange_fixture_leaf(capacity, "exchange_origin")) and record_equal(first_rows, exchange_fixture_leaf(capacity, "exchange_rows")), "Full-capacity reuse rewrote first receipt")
haiku_contact_save(capacity, text_concat(exchange_test_prefix, "capacity"))

# An inert exchange profile preserves the preceding contact/symbol behavior.
off = haiku_contact_load(text_concat(exchange_fixture_prefix, "off"))
plain = haiku_contact_load(text_concat(exchange_fixture_prefix, "receiver-v3"))
off_memory = exchange_fixture_memory(off)
native = exchange_fixture_native("haiku", "fire water tree", 100, 43)
packet = haiku_contact_exchange_offer(sender_before, native)
peer = haiku_contact_derive(native, "friend", "fire water tree", 6, 100, 43)
haiku_contact_publish(off, peer)
haiku_contact_publish(plain, peer)
exchange_fixture_dream(off, 2, 43)
exchange_fixture_dream(plain, 2, 43)
off_before = record_clone(off)
haiku_contact_exchange_recv(off, peer, packet, 2)
assert(record_equal(off_before, off) and record_equal(off_memory, exchange_fixture_memory(off)), "Disabled exchange changed its owned memory")
native = exchange_fixture_native("friend", "tree light", 44, 44)
packet = haiku_contact_exchange_offer(off, native)
assert(record_get(packet, "available") == 0, "Disabled exchange exported a known structure")
base = record_new()
names = record_keys(plain)
i = 0
while i < list_len(names):
    name = list_get(names, i)
    record_set(base, name, record_get(off, name))
    i = i + 1
record_set(base, "version", 3)
assert(record_equal(base, plain), "Disabled exchange changed the preceding contact or RNG profile")
haiku_contact_save(base, text_concat(exchange_test_prefix, "off-base"))
haiku_contact_save(plain, text_concat(exchange_test_prefix, "off-control"))
PRINT "HAIKU_CONTACT_EXCHANGE_LIFE_OK"
