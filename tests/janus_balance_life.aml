IMPORT "janus_balance_support.aml"

live = haiku_janus_new("haiku", 1, 0.5, 20740, 0)
friend = haiku_janus_new("friend", 1, 0.5, 20740, 6)
assert(list_len(record_keys(live)) == 20, "Janus owner exceeded its state budget")
calendar = haiku_janus_calendar(20740)
assert(calendar[0] == 740 and abs(calendar[1] + 7.2073927) < 0.00001, "Janus C day740 drift differs")
assert(abs(calendar[2] - 0.21840584) < 0.000001, "Janus C signed remainder differs")
negative = haiku_janus_calendar(19634)
assert(negative[0] == -365 and abs(negative[1] + 11.242299) < 0.00001, "Janus negative full-cycle convention differs")
assert(abs(negative[2] - 0.34067574) < 0.000001, "Janus negative dissonance differs")
epoch_before = haiku_janus_calendar(19999)
epoch_after = haiku_janus_calendar(20000)
assert(epoch_before[0] == 0 and epoch_after[0] == 0, "Janus noon epoch lost signed integer truncation")
snapshot = haiku_janus_snapshot(live, 20740)
alpha = record_get(snapshot, "alpha")
assert(abs(alpha - 0.41552174) < 0.000001, "Janus initial dynamic equation differs")
assert(record_get(snapshot, "janus_blend") == 1 - alpha, "AML Janus blend orientation differs")
janus_test_save(live, "pure.before")
tomorrow = haiku_janus_snapshot(live, 20741)
janus_test_save(live, "pure.after")
assert(record_get(tomorrow, "alpha") != alpha, "Calendar alone did not change the captured balance")

fixed = haiku_janus_new("haiku", 0, 0.5, 20740, 0)
endpoint_a = haiku_janus_new("haiku", 0, 1, 20740, 0)
endpoint_b = haiku_janus_new("haiku", 0, 0, 20740, 0)
assert(record_get(haiku_janus_snapshot(fixed, 21000), "alpha") == 0.5, "Fixed balance drifted")
assert(record_get(haiku_janus_snapshot(endpoint_a, 21000), "alpha") == 1, "A endpoint drifted")
assert(record_get(haiku_janus_snapshot(endpoint_b, 21000), "alpha") == 0, "B endpoint drifted")

receipt = janus_test_receipt("haiku", alpha, 1, 1, 1)
assert(haiku_janus_expect(live, receipt, 20740) == 1, "Completed pass did not create an expectation")
janus_test_save(friend, "owner.before")
janus_test_save(live, "ignored.before")
human_now = haiku_contact_event("human", "water", "en", [0.5, 0.5, 1, 0.5], [0], 0.5, 0, 1, 1)
same_turn = haiku_janus_witness(live, human_now, 20740)
assert(record_get(same_turn, "committed") == 0, "Current context graded its own expectation")
self = haiku_contact_event("haiku", "water", "en", [0.5, 0.5, 1, 0.5], [0], 0.5, 7, 2, 2)
ignored = haiku_janus_witness(live, self, 20740)
assert(record_get(ignored, "committed") == 0, "Own dream became an external witness")
assert(haiku_janus_expect(live, receipt, 20740) == 0, "Completed receipt replay replaced its expectation")
janus_test_save(live, "ignored.after")

# A lower-ranked observed word creates debt; repeated spelling counts once.
human_later = haiku_contact_event("human", "water water tree", "en", [0.5, 0.5, 1, 0.5], [0], 0.5, 0, 2, 2)
witness = haiku_janus_witness(live, human_later, 20740)
expected_gap = 46.5 / 47.5
assert(record_get(witness, "assessed") == 1 and record_get(witness, "matched") == 2, "Witness unique whole words differ")
assert(abs(record_get(witness, "gap") - expected_gap) < 0.000001, "Witness full-pool contrast differs")
assert(abs(record_get(live, "debt") - 0.1 * expected_gap) < 0.000001, "Operative prophecy debt remained zero")
new_alpha = record_get(haiku_janus_snapshot(live, 20740), "alpha")
assert(abs(new_alpha - (alpha - 0.2 * record_get(live, "debt"))) < 0.000001, "Measured debt did not change dynamic balance")
janus_test_save(friend, "owner.after")
janus_test_save(live, "replay.before")
ignored = haiku_janus_witness(live, human_later, 20000)
record_set(human_later, "event", 99)
record_set(human_later, "origin_event", 99)
record_set(human_later, "replay", 1)
ignored = haiku_janus_witness(live, human_later, 20000)
janus_test_save(live, "replay.after")

# Top-word fulfilment reduces debt, then no-overlap consumes without invention.
receipt = janus_test_receipt("haiku", new_alpha, 2, 2, 0)
haiku_janus_expect(live, receipt, 20740)
top = haiku_contact_event("human", "dawn", "en", [0.5, 0.5, 1, 0.5], [0], 0.5, 0, 3, 3)
before_debt = record_get(live, "debt")
fulfilled = haiku_janus_witness(live, top, 20740)
assert(record_get(fulfilled, "gap") == 0 and record_get(live, "debt") == 0.9 * before_debt, "Fulfilled expectation did not reduce debt")
receipt = janus_test_receipt("haiku", record_get(haiku_janus_snapshot(live, 20740), "alpha"), 3, 3, 1)
haiku_janus_expect(live, receipt, 20740)
unknown = haiku_contact_event("human", "unmapped galaxies", "en", [0.5, 0.5, 1, 0.5], [0], 0.5, 0, 4, 4)
before_debt = record_get(live, "debt")
unassessed = haiku_janus_witness(live, unknown, 20740)
assert(record_get(unassessed, "consumed") == 1 and record_get(unassessed, "assessed") == 0, "No-overlap semantics differ")
assert(record_get(live, "debt") == before_debt, "Unknown word invented a score")
meta = record_get(live, "pending_meta")
assert(meta[0] == 0, "No-overlap witness left a pending expectation alive")

# Friend's witness is the actual later Haiku line delivered from a dream.
friend_alpha = record_get(haiku_janus_snapshot(friend, 20740), "alpha")
friend_receipt = janus_test_receipt("friend", friend_alpha, 2, 1, 1)
haiku_janus_expect(friend, friend_receipt, 20740)
native = haiku_contact_event("haiku", "water", "en", [0.5, 0.5, 1, 0.5], [0], 0.5, 7, 3, 2)
delivered = haiku_contact_derive(native, "friend", "water", 6, 3, 2)
peer_witness = haiku_janus_witness(friend, delivered, 20740)
assert(record_get(peer_witness, "assessed") == 1 and record_get(friend, "debt") > 0, "Later delivered peer did not meet the friend's expectation")
friend_receipt = janus_test_receipt("friend", record_get(haiku_janus_snapshot(friend, 20740), "alpha"), 4, 2, 0)
haiku_janus_expect(friend, friend_receipt, 20740)
janus_test_save(friend, "peer_replay.before")
reminted = haiku_contact_derive(native, "friend", "water", 6, 20, 3)
ignored = haiku_janus_witness(friend, reminted, 20740)
assert(record_get(ignored, "committed") == 0, "Old peer line reminted a new witness")
model_echo = haiku_contact_derive(native, "haiku", "water", 4, 21, 3)
record_set(model_echo, "availability", 6)
record_set(model_echo, "identity", "declared-fixture")
record_set(model_echo, "alpha", 0.5)
model_delivery = haiku_contact_derive(model_echo, "friend", "water", 6, 21, 3)
ignored = haiku_janus_witness(friend, model_delivery, 20740)
assert(record_get(ignored, "committed") == 0, "Model peer echo became a witness")
janus_test_save(friend, "peer_replay.after")

# A pending expectation and its later witness survive an exact checkpoint.
janus_test_save(friend, "restart")
resumed = haiku_janus_load(text_concat(janus_test_prefix, "restart"))
native = haiku_contact_event("haiku", "tree", "en", [0.5, 0.5, 1, 0.5], [0], 0.5, 7, 5, 4)
delivered = haiku_contact_derive(native, "friend", "tree", 6, 5, 4)
haiku_janus_witness(friend, delivered, 20741)
haiku_janus_witness(resumed, delivered, 20741)
janus_test_save(friend, "full")
janus_test_save(resumed, "resumed")

# Sixteen bounded receipts retain chronology through wraparound.
i = 5
while i < 24:
    external = haiku_contact_event("human", "water", "en", [0.5, 0.5, 1, 0.5], [0], 0.5, 0, i, i)
    haiku_janus_witness(live, external, 20741)
    i = i + 1
assert(record_get(live, "history_count") == 16, "Janus bounded receipt history did not wrap")
haiku_janus_check(live)
PRINT "HAIKU_JANUS_BALANCE_LIFE_OK"
