# Frozen dual-body passes coexist with native dream-symbol evidence.
IMPORT "../src/iceberg_session.aml"

day = 20740
a = model_try_load("../weights/haiku1.gguf")
b = model_try_load("../weights/haiku2.gguf")
assert(model_ready(a) and model_ready(b), "Symbol fixture needs both immutable bodies")
core = haiku_state_enable_dreams(haiku_state_new("regex", 0, 0, 575, 57), 0)
record_set(core, "dream_config", [1, 1, 2])
serial = haiku_iceberg_enable_symbols(haiku_iceberg_enable_words(haiku_iceberg_enable_janus(haiku_iceberg_new(core, [1, 1, 2, 1]), day, 1, 0), 0), 1, 0)
parallel = record_clone(serial)
first = haiku_iceberg_turn_at(serial, "rain", 0, a, b, 0, day)
second = haiku_iceberg_turn_at(parallel, "rain", 0, a, b, 1, day)
assert(text_equal(first, second) and record_equal(serial, parallel), "Symbol life with both real bodies differs between schedules")
core = haiku_iceberg_part(serial, "voice")
assert(haiku_dream_check(core) == 1 and list_len(record_get(core, "dream_history")) == 2, "Dual-body symbol fixture did not deliver its real dream")
friend = haiku_iceberg_part(serial, "friend_contact")
seen = record_get(friend, "p:seen")
clock = record_get(friend, "symbol_clock")
assert(seen[0] == 0 and seen[6] == 1 and seen[7] == 2, "Friend source clocks lost actual dream ancestry")
assert(clock[4] == 1 and clock[8] == 0 and clock[32] == 1 and clock[26] == 0, "Friend symbols counted a source other than actual Haiku delivery")
clock = record_get(serial, "haiku_contact:symbol_clock")
assert(clock[4] == 1 and clock[8] == 0 and clock[26] == 1 and clock[7] == 1 and clock[28] + clock[29] + clock[30] == 1, "Symbol history did not separate external evidence from its model source clock")
assert(record_get(serial, "haiku_lexical:revision") > 0 and record_get(serial, "friend_lexical:revision") > 0, "Symbol life lost one presence's real lexical pass")
assert(record_get(serial, "haiku_janus:revision") > 0 and record_get(serial, "friend_janus:revision") > 0, "Symbol life lost one presence's Janus history")
checkpoint_save(serial, "iceberg-symbols-models.state")
resumed = checkpoint_load("iceberg-symbols-models.state")
haiku_iceberg_check(resumed, 0)
assert(record_equal(serial, resumed), "Real-body symbol checkpoint lost a leaf")
missing = model_try_load("")
record_set(serial, "voice:dream_config", [10000, 0, 2])
record_set(resumed, "voice:dream_config", [10000, 0, 2])
friend_before = haiku_iceberg_part(serial, "friend_contact")
first = haiku_iceberg_turn_at(serial, "fire water", 0, missing, missing, 0, day + 1)
second = haiku_iceberg_turn_at(resumed, "fire water", 0, missing, missing, 1, day + 1)
assert(text_equal(first, second) and record_equal(serial, resumed), "Symbol life did not resume exactly with absent optional bodies")
assert(record_equal(friend_before, haiku_iceberg_part(serial, "friend_contact")), "Waking evidence crossed into the unheard friend's symbols")
checkpoint_save(serial, "iceberg-symbols-models.state")
PRINT "HAIKU_ICEBERG_SYMBOLS_MODELS_OK"
