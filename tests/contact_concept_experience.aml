IMPORT "../src/parliament_contact.aml"

def concept_test_owner(owner, seed, symbols, mode):
    state = haiku_contact_enable_learning(haiku_contact_new(owner, seed))
    state = haiku_contact_enable_symbols(state, symbols, 0)
    state = haiku_contact_enable_exchange(state, 0, 0, 0)
    return haiku_contact_enable_concepts(state, mode)

def concept_test_snapshot(state):
    result = record_new()
    record_set(result, "clock", record_get(state, "concept_clock"))
    record_set(result, "counts", record_get(state, "concept_counts"))
    return record_clone(result)

climate = [0.5, 0.5, 1, 0.5]
legacy = haiku_contact_enable_learning(haiku_contact_new("haiku", 42))
legacy = haiku_contact_enable_symbols(legacy, 1, 0)
legacy = haiku_contact_enable_exchange(legacy, 0, 0, 0)
first = haiku_contact_event("human", "Water water, RAIN!", "en", climate, [0], 0.5, 0, 1, 1)
haiku_contact_publish(legacy, first)
original = record_clone(legacy)
personal = haiku_contact_enable_concepts(legacy, 2)
equal = haiku_contact_enable_concepts(legacy, 1)
off = haiku_contact_enable_concepts(legacy, 0)
assert(record_equal(legacy, original), "Concept upgrade changed its predecessor")
assert(record_get(legacy, "version") == 4 and list_len(record_keys(legacy)) == 55, "Concept upgrade changed the legacy schema")
assert(record_get(personal, "version") == 5 and list_len(record_keys(personal)) == 61, "Personal concept schema differs")
assert(record_equal(personal, haiku_contact_enable_concepts(personal, 0)), "Concept mode changed through repeated activation")
counts = record_get(personal, "concept_counts")
equal_counts = record_get(equal, "concept_counts")
assert(counts[0] == 1 and counts[1] == 1 and haiku_parliament_dot(counts, counts) == 2, "Existing unique alias encounters were not retained")
assert(equal_counts[0] == 1 and equal_counts[1] == 1, "Equal mode lost its own visible witness counts")
assert(haiku_parliament_dot(record_get(off, "concept_counts"), record_get(off, "concept_counts")) == 0, "Disabled concepts acquired historical counts")
haiku_contact_concepts_check(personal, 1)
haiku_contact_save(legacy, text_concat(concept_test_prefix, "legacy"))
haiku_contact_save(personal, text_concat(concept_test_prefix, "first"))

# The current encounter and all following owned work read the earlier snapshot.
previous = concept_test_snapshot(personal)
cache_before = haiku_contact_concept_cache(personal)
second = haiku_contact_event("human", "rain rain tree forest", "en", climate, [0], 0.5, 0, 2, 2)
haiku_contact_publish(personal, second)
assert(record_equal(previous, concept_test_snapshot(personal)), "Current human contact changed its own concept snapshot")
cloud = haiku_contact_event("haiku", "music song", "en", climate, [0], 0.5, 1, 2, 2)
inner = haiku_contact_event("haiku", "light sun", "en", climate, [0], 0.5, 5, 2, 2)
spoken = haiku_contact_event("haiku", "water ocean", "en", climate, [0], 0.5, 7, 10, 2)
haiku_contact_publish(personal, cloud)
haiku_contact_publish(personal, inner)
haiku_contact_publish(personal, spoken)
model = haiku_contact_derive(inner, "haiku", "piano dawn", 4, 2, 2)
record_set(model, "availability", 6)
record_set(model, "alpha", 0.5)
record_set(model, "identity", "explicit-test-model-event")
haiku_contact_publish(personal, model)
assert(record_equal(previous, concept_test_snapshot(personal)), "Owned or model work taught its own concept snapshot")
haiku_contact_concepts_finish(personal)
counts = record_get(personal, "concept_counts")
clock = record_get(personal, "concept_clock")
assert(clock[1] == 2 and clock[2] == 2 and clock[3] == 2, "Completed concept snapshot lost its exact human cutoff")
assert(counts[0] == 1 and counts[1] == 2 and counts[6] == 1 and counts[7] == 1, "Second human encounter counts differ")
assert(counts[4] == 0 and counts[10] == 0 and counts[15] == 0 and counts[19] == 0, "Internal or model words became teachers")
assert(record_equal(cache_before, haiku_contact_concept_cache(personal)), "Weightless encounters changed a numerical cache")
before = record_clone(personal)
haiku_contact_publish(personal, second)
haiku_contact_concepts_finish(personal)
replay = haiku_contact_event("human", "water music", "en", climate, [0], 0.5, 0, 999, 3)
record_set(replay, "replay", 1)
haiku_contact_publish(personal, replay)
haiku_contact_concepts_finish(personal)
assert(record_equal(before, personal), "Repeated encounter or finish changed owner state or random draws")

# A reviewed spelling in another language, a manual alias and a learned word
# keep their own histories; none acquires a second role as a reviewed teacher.
foreign = haiku_contact_event("human", "water light", "fr", climate, [0], 0.5, 0, 3, 3)
haiku_contact_publish(personal, foreign)
haiku_contact_concepts_finish(personal)
counts = record_get(personal, "concept_counts")
assert(counts[0] == 1 and counts[10] == 0, "Concept teacher crossed its language namespace")
manual = haiku_contact_event("human", "brook", "en", climate, [0], 0.5, 0, 4, 4)
haiku_contact_publish(personal, manual)
haiku_contact_bind(personal, "en", "brook", 0, 0, 4)
haiku_contact_concepts_finish(personal)
teaching = list_new()
list_push(teaching, "stream water river")
list_push(teaching, "stream sea ocean")
list_push(teaching, "stream rain lake")
i = 0
while i < 3:
    event = haiku_contact_event("human", list_get(teaching, i), "en", climate, [0], 0.5, 0, i + 5, i + 5)
    haiku_contact_publish(personal, event)
    haiku_contact_concepts_finish(personal)
    i = i + 1
binding = haiku_contact_learning_lookup(personal, "en", "stream")
assert(binding[0] == 0 and binding[1] == 0.5, "Existing word learner did not complete its own evidence")
count_before = record_new()
record_set(count_before, "counts", record_get(personal, "concept_counts"))
event = haiku_contact_event("human", "stream brook", "en", climate, [0], 0.5, 0, 8, 8)
haiku_contact_publish(personal, event)
haiku_contact_concepts_finish(personal)
count_after = record_new()
record_set(count_after, "counts", record_get(personal, "concept_counts"))
assert(record_equal(count_before, count_after), "Learned or manual binding became a reviewed concept teacher")
haiku_contact_concepts_check(personal, 1)
haiku_contact_save(personal, text_concat(concept_test_prefix, "before"))
resumed = haiku_contact_load(text_concat(concept_test_prefix, "before"))
event = haiku_contact_event("human", "music song", "en", climate, [0], 0.5, 0, 9, 9)
haiku_contact_publish(personal, event)
haiku_contact_publish(resumed, event)
haiku_contact_concepts_finish(personal)
haiku_contact_concepts_finish(resumed)
assert(record_equal(personal, resumed), "Concept restart changed the next owned snapshot")
haiku_contact_concepts_check(personal, 1)
haiku_contact_save(personal, text_concat(concept_test_prefix, "full"))
haiku_contact_save(resumed, text_concat(concept_test_prefix, "resumed"))

friend = concept_test_owner("friend", 43, 1, 2)
previous = concept_test_snapshot(friend)
haiku_contact_publish(friend, first)
haiku_contact_concepts_finish(friend)
assert(record_equal(previous, concept_test_snapshot(friend)), "Friend received a waking human teacher")
native = haiku_contact_event("haiku", "music music song", "en", climate, [0], 0.5, 7, 30, 2)
delivered = haiku_contact_derive(native, "friend", record_get(native, "text"), 6, 30, 2)
haiku_contact_publish(friend, delivered)
native = haiku_contact_event("haiku", "music drum", "en", climate, [0], 0.5, 7, 31, 2)
delivered = haiku_contact_derive(native, "friend", record_get(native, "text"), 6, 31, 2)
haiku_contact_publish(friend, delivered)
assert(record_equal(previous, concept_test_snapshot(friend)), "Friend updated between lines of its owned tail")
haiku_contact_concepts_finish(friend)
clock = record_get(friend, "concept_clock")
counts = record_get(friend, "concept_counts")
assert(clock[1] == 1 and clock[2] == 31 and clock[3] == 2, "Two same-turn peer encounters created more than one snapshot")
assert(counts[15] == 2 and counts[16] == 1 and counts[20] == 1, "Friend lost per-encounter unique alias counts")
previous = concept_test_snapshot(friend)
echo = haiku_contact_derive(first, "haiku", "water rain", 7, 40, 3)
echo = haiku_contact_derive(echo, "friend", "water rain", 6, 40, 3)
haiku_contact_publish(friend, echo)
own = haiku_contact_event("friend", "water rain", "en", climate, [0], 0.5, 7, 41, 3)
haiku_contact_publish(friend, own)
haiku_contact_concepts_finish(friend)
assert(record_equal(previous, concept_test_snapshot(friend)), "Friend counted a returned human echo or its own voice")
haiku_contact_concepts_check(friend, 1)
haiku_contact_save(friend, text_concat(concept_test_prefix, "friend"))

# Distinct aliases have separate weights, rather than sharing unit event mass.
many = concept_test_owner("haiku", 44, 1, 2)
all_words = "water rain river sea ocean lake tree forest wood leaf light sun sunrise dawn bright music song melody guitar piano drum water"
event = haiku_contact_event("human", all_words, "en", climate, [0], 0.5, 0, 1, 1)
haiku_contact_publish(many, event)
haiku_contact_concepts_finish(many)
counts = record_get(many, "concept_counts")
assert(haiku_parliament_dot(counts, counts) == 21, "Unique aliases did not each count once per encounter")

disabled = concept_test_owner("haiku", 45, 0, 0)
previous = concept_test_snapshot(disabled)
event = haiku_contact_event("human", "water rain", "en", climate, [0], 0.5, 0, 1, 1)
haiku_contact_publish(disabled, event)
haiku_contact_concepts_finish(disabled)
assert(record_equal(previous, concept_test_snapshot(disabled)), "Disabled concepts changed their snapshot")
haiku_contact_concepts_check(disabled, 1)
haiku_contact_save(disabled, text_concat(concept_test_prefix, "off"))

# Exercise the same replay kernel used by publication to resolve the actual
# 128-entry retention boundary, without repeating parliament/model work.
shadow = concept_test_owner("haiku", 46, 1, 2)
event = haiku_contact_event("human", "water", "en", climate, [0], 0.5, 0, 1, 1)
haiku_contact_symbols_step(shadow, event)
haiku_contact_concepts_finish(shadow)
previous = concept_test_snapshot(shadow)
i = 2
while i <= 129:
    event = haiku_contact_event("human", "tree tree", "en", climate, [0], 0.5, 0, i, i)
    haiku_contact_symbols_step(shadow, event)
    i = i + 1
assert(record_equal(previous, concept_test_snapshot(shadow)), "Ring eviction rewrote the frozen prior snapshot")
haiku_contact_concepts_check(shadow, 0)
haiku_contact_concepts_finish(shadow)
counts = record_get(shadow, "concept_counts")
clock = record_get(shadow, "concept_clock")
assert(counts[0] == 0 and counts[6] == 128 and clock[1] == 2 and clock[2] == 129, "Concept counts did not follow exact external-window retention")
haiku_contact_concepts_check(shadow, 1)
checkpoint_save(concept_test_snapshot(shadow), text_concat(concept_test_prefix, "window"))
PRINT "PASS: owned concept witnesses, prior snapshots, modes, replay, restart and 128-encounter retention"
