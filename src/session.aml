# One accepted exchange publishes the voice and its completed inner life.
IMPORT "state.aml"

# Accept one foreground exchange into an already detached candidate. Its flat
# experience record travels beside that candidate; runtime model handles stay
# outside both records. The caller handles blank/quit/EOF before accepting it.
def haiku_session_prepare(pending, source, model):
    return haiku_session_prepare_pressure(pending, source, model, map_new())

# A complete iceberg can supply bounded pressure earned before this input.
# Empty pressure preserves the original candidate generation and RAE path.
def haiku_session_prepare_pressure(pending, source, model, pressure):
    haiku_state_check(pending, model)
    assert(haiku_input_action(source) == 1, "Haiku session needs an accepted input")
    if record_get(pending, "version") >= 2:
        assert(list_len(record_get(pending, "meta_history")) < 30000, "Haiku reflection history limit is 10000")
    words = haiku_tokenize(source, record_get(pending, "tokenizer_mode"), model)
    user = haiku_trigrams(words)
    haiku_foreground_input(words, user)
    turn = record_get(pending, "turn")
    assert(turn < 16777216, "Haiku turn increment exceeds 2^24")
    turn = turn + 1
    clock = turn
    haiku_cloud_morph(record_get(pending, "weights"), record_get(pending, "frequencies"), record_get(pending, "last_used"), record_get(pending, "origins"), words, clock)
    haiku_store_trigrams(record_get(pending, "observer_rows"), record_get(pending, "observer_counts"), record_get(pending, "observer_resonance"), user)
    recent = haiku_chain_update(record_get(pending, "rows"), record_get(pending, "counts"), record_get(pending, "vocab"), record_get(pending, "recent"), user)
    record_set(pending, "recent", recent)
    system = list_clone(recent)
    observation = haiku_observe_trigrams(user, system)
    temperatures = haiku_temperatures(observation[0])
    haiku_foreground_cache(record_get(pending, "syllables"), record_get(pending, "vocab"))
    living = record_get(pending, "version") == 4
    form_receipt = zeros(9)
    targets = zeros(1)
    candidates = list_new()
    choice = zeros(2)
    if living:
        form_receipt = haiku_living_snapshot(pending, observation)
        targets = haiku_living_targets(form_receipt[0])
        voice_rng = record_get(pending, "voice_rng")
        candidates = haiku_living_generate(record_get(pending, "rows"), record_get(pending, "counts"), record_get(pending, "vocab"), record_get(pending, "syllables"), 5, temperatures[0], voice_rng, record_get(pending, "draws"), form_receipt[0])
        if map_len(pressure) > 0:
            choice = haiku_living_rae_pressure(record_get(pending, "rae"), candidates, user, 3, targets, pressure)
        else:
            choice = haiku_living_rae_select(record_get(pending, "rae"), candidates, user, 3, targets)
    else:
        candidates = haiku_generate_candidates(record_get(pending, "rows"), record_get(pending, "counts"), record_get(pending, "vocab"), record_get(pending, "syllables"), 5, temperatures[0], record_get(pending, "voice_rng"), record_get(pending, "draws"))
        choice = haiku_rae_select(record_get(pending, "rae"), candidates, user, 3)
    spoken = list_get(candidates, choice[0])

    quality = haiku_foreground_quality(observation)
    bridge_event = haiku_foreground_bridge(observation, quality, turn, clock)
    experience = haiku_journal_capture(pending, source, spoken, user, system, temperatures, turn)
    if living:
        record_set(experience, "form_receipt", form_receipt)
    record_set(experience, "base_revision", turn - 1)
    record_set(experience, "observation", observation)
    record_set(experience, "quality", quality)
    record_set(experience, "bridge_event", bridge_event)
    return experience

# This exact tail serves both schedules. All mutations stay with the candidate;
# this tail performs no checkpoint publication.
def haiku_session_tail(pending, experience, model):
    experience = record_clone(experience)
    turn = record_get(experience, "turn")
    assert(record_get(pending, "turn") == record_get(experience, "base_revision"), "Haiku tail base revision differs")
    assert(turn == record_get(experience, "base_revision") + 1, "Haiku tail revision does not follow its base")
    source = record_get(experience, "input")
    spoken = record_get(experience, "output")
    user = haiku_journal_unpack(record_get(experience, "user_key"))
    observation = record_get(experience, "observation")
    quality = record_get(experience, "quality")
    bridge_event = record_get(experience, "bridge_event")
    if record_get(pending, "version") >= 3:
        haiku_phase4_turn(pending, bridge_event)
    if record_get(pending, "version") == 4:
        haiku_living_append(pending, experience)
        receipt = record_get(experience, "form_receipt")
        targets = haiku_living_targets(receipt[0])
        haiku_living_mathbrain_observe(record_get(pending, "mathbrain"), record_get(pending, "mathbrain_state"), spoken, record_get(pending, "rows"), record_get(pending, "counts"), user, quality, targets)
        if record_get(pending, "train_rae"):
            haiku_living_rae_observe(record_get(pending, "rae"), record_get(pending, "rae_state"), spoken, user, quality, targets)
    else:
        haiku_mathbrain_observe(record_get(pending, "mathbrain"), record_get(pending, "mathbrain_state"), spoken, quality, record_get(pending, "rows"), record_get(pending, "counts"), user)
        if record_get(pending, "train_rae"):
            haiku_rae_observe(record_get(pending, "rae"), record_get(pending, "rae_state"), spoken, quality, user)
    record_set(pending, "bridge_event", bridge_event)
    record_set(pending, "turn", turn)
    record_set(pending, "clock", turn)
    if record_get(pending, "version") >= 2:
        haiku_meta_reflect(pending, source, spoken, observation, turn)
        rings = haiku_overthinkg(pending, user)
        record_set(pending, "ring_trigrams", record_get(rings, "trigrams"))
        record_set(pending, "ring_coherence", record_get(rings, "coherence"))
        record_set(pending, "ring_admission", record_get(rings, "admission"))
    if record_get(pending, "version") >= 3:
        if haiku_dream_should(pending, bridge_event):
            haiku_dream_run(pending, spoken, model)
        haiku_journal_append(pending, experience)
    haiku_state_check(pending, model)
    # Flat records cannot contain another record. Keep two disjoint namespaces
    # in a transient envelope; only its validated state reaches a checkpoint.
    result = record_new()
    record_set(result, "format", "haiku-tail-result")
    record_set(result, "version", 1)
    state_keys = record_keys(pending)
    experience_keys = record_keys(experience)
    record_set(result, "state_keys", state_keys)
    record_set(result, "experience_keys", experience_keys)
    cursor = 0
    while cursor < list_len(state_keys):
        key = list_get(state_keys, cursor)
        record_set(result, text_concat("state:", key), record_get(pending, key))
        cursor = cursor + 1
    cursor = 0
    while cursor < list_len(experience_keys):
        key = list_get(experience_keys, cursor)
        record_set(result, text_concat("experience:", key), record_get(experience, key))
        cursor = cursor + 1
    return result

# The sole publisher checks the full frozen experience, then returns an owned
# state. Same-base jobs must agree in every leaf, including float32 bits.
def haiku_session_result_check(state, result, experience, model):
    assert(record_get(state, "turn") == record_get(experience, "base_revision"), "Haiku completed tail has a stale base revision")
    haiku_state_fields(result, "format", "string")
    haiku_state_fields(result, "version", "float")
    haiku_state_fields(result, "state_keys experience_keys", "list")
    assert(text_equal(record_get(result, "format"), "haiku-tail-result") and record_get(result, "version") == 1, "Haiku completed tail envelope is unsupported")
    state_keys = record_keys(state)
    experience_keys = record_keys(experience)
    assert(text_equal(list_key(record_get(result, "state_keys")), list_key(state_keys)), "Haiku completed tail state fields differ")
    assert(text_equal(list_key(record_get(result, "experience_keys")), list_key(experience_keys)), "Haiku completed tail experience fields differ")
    assert(list_len(record_keys(result)) == 4 + list_len(state_keys) + list_len(experience_keys), "Haiku completed tail envelope field count differs")
    receipt = record_new()
    cursor = 0
    while cursor < list_len(experience_keys):
        key = list_get(experience_keys, cursor)
        record_set(receipt, key, record_get(result, text_concat("experience:", key)))
        cursor = cursor + 1
    assert(record_equal(receipt, experience), "Haiku completed tail belongs to another experience")
    completed = record_new()
    cursor = 0
    while cursor < list_len(state_keys):
        key = list_get(state_keys, cursor)
        record_set(completed, key, record_get(result, text_concat("state:", key)))
        cursor = cursor + 1
    assert(record_get(completed, "turn") == record_get(experience, "turn"), "Haiku completed tail revision differs")
    assert(record_get(completed, "turn") == record_get(state, "turn") + 1, "Haiku completed tail must advance exactly one turn")
    haiku_state_check(completed, model)
    assert(record_get(completed, "version") == record_get(state, "version"), "Haiku completed tail changed its profile")
    assert(record_get(completed, "train_rae") == record_get(state, "train_rae"), "Haiku completed tail changed its learner mode")
    assert(text_equal(record_get(completed, "tokenizer_mode"), record_get(state, "tokenizer_mode")), "Haiku completed tail changed its tokenizer mode")
    assert(text_equal(record_get(completed, "tokenizer_identity"), record_get(state, "tokenizer_identity")), "Haiku completed tail changed its tokenizer identity")
    if record_get(completed, "version") == 4:
        assert(record_get(completed, "form_started_turn") == record_get(state, "form_started_turn"), "Haiku completed tail changed its form boundary")
        assert(record_get(completed, "inner_started_turn") == record_get(state, "inner_started_turn"), "Haiku completed tail changed its inner boundary")
        assert(record_get(completed, "phase4_started_turn") == record_get(state, "phase4_started_turn"), "Haiku completed tail changed its journal boundary")
        names = haiku_words("meta_history journal_text")
        field = 0
        while field < 2:
            name = list_get(names, field)
            old = record_get(state, name)
            new = record_get(completed, name)
            haiku_living_words_prefix(old, new)
            field = field + 1
        names = haiku_words("meta_metrics journal_values")
        counts = zeros(2)
        counts[0] = record_get(state, "turn") - record_get(state, "inner_started_turn")
        counts[1] = record_get(state, "turn") - record_get(state, "phase4_started_turn")
        widths = [5, 13]
        field = 0
        while field < 2:
            name = list_get(names, field)
            old = record_get(state, name)
            new = record_get(completed, name)
            haiku_living_prefix(old, new, counts[field] * widths[field])
            field = field + 1
        expected_form = haiku_living_snapshot(state, record_get(experience, "observation"))
        haiku_living_equal(record_get(experience, "form_receipt"), expected_form)
        actual_form = haiku_living_get(completed, record_get(experience, "turn"))
        haiku_living_equal(actual_form, expected_form)
        prior_form = record_get(state, "form_values")
        next_form = record_get(completed, "form_values")
        prior_count = (record_get(state, "turn") - record_get(state, "form_started_turn")) * 9
        haiku_living_prefix(prior_form, next_form, prior_count)
    if record_get(completed, "version") >= 2:
        history = record_get(completed, "meta_history")
        assert(text_equal(list_get(history, list_len(history) - 3), record_get(experience, "input")), "Haiku completed tail belongs to another input")
        assert(text_equal(list_get(history, list_len(history) - 2), record_get(experience, "output")), "Haiku completed tail belongs to another response")
    return completed

# Serial scheduling remains available for exact continuation and comparison.
def haiku_session_turn(state, source, model):
    pending = record_clone(state)
    experience = haiku_session_prepare(pending, source, model)
    result = haiku_session_tail(pending, experience, model)
    completed = haiku_session_result_check(state, result, experience, model)
    record_replace(state, completed)
    return record_get(experience, "output")

# One owned worker, one complete result. SPAWN snapshots the candidate and
# experience, including their PCG state. Joining transfers the completed record
# out of worker lifetime. The caller still saves before revealing the response.
def haiku_session_worker_turn(state, source, model):
    pending = record_clone(state)
    experience = haiku_session_prepare(pending, source, model)
    SPAWN haiku_tail:
        return haiku_session_tail(pending, experience, model)
    AWAIT haiku_tail INTO result
    completed = haiku_session_result_check(state, result, experience, model)
    record_replace(state, completed)
    return record_get(experience, "output")
