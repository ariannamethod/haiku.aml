# Two private lives below the existing three-line voice.
# All organs travel in one flat checkpoint; immutable handles stay outside.
IMPORT "session.aml"
IMPORT "lexical_sources.aml"
IMPORT "parliament_contact.aml"
IMPORT "janus_balance.aml"

# Flat namespaces preserve each component's own version and validator.
def haiku_iceberg_put(envelope, name, part):
    keys = record_keys(part)
    record_set(envelope, text_concat(name, ":keys"), keys)
    cursor = 0
    while cursor < list_len(keys):
        key = list_get(keys, cursor)
        record_set(envelope, text_concat(text_concat(name, ":"), key), record_get(part, key))
        cursor = cursor + 1
    return list_len(keys) + 1

# A read returns detached leaves, so inspecting or changing one presence cannot
# mutate the composite or its peer before the completed candidate is published.
def haiku_iceberg_part(envelope, name):
    keys = record_get(envelope, text_concat(name, ":keys"))
    result = record_new()
    cursor = 0
    while cursor < list_len(keys):
        key = list_get(keys, cursor)
        assert(record_has(result, key) == 0, "Haiku iceberg namespace repeats a field")
        record_set(result, key, record_get(envelope, text_concat(text_concat(name, ":"), key)))
        cursor = cursor + 1
    return record_clone(result)

# Settings: deeper life, lexical bodies, admission budget, self-text injection.
def haiku_iceberg_settings(settings):
    assert(len(settings) == 4 and rows(settings) == 0 and cols(settings) == 0, "Haiku iceberg needs four settings")
    haiku_state_integer(settings[0], 0, 1)
    haiku_state_integer(settings[1], 0, 1)
    haiku_state_integer(settings[2], 0, 2)
    haiku_state_integer(settings[3], 0, 1)
    return 1

def haiku_iceberg_pack(core, haiku_lexical, friend_lexical, haiku_contact, friend_contact, settings, admission_text, admission_values):
    result = record_new()
    record_set(result, "format", "haiku-iceberg")
    record_set(result, "version", 1)
    record_set(result, "settings", settings)
    record_set(result, "admission_text", admission_text)
    record_set(result, "admission_values", admission_values)
    haiku_iceberg_put(result, "voice", core)
    haiku_iceberg_put(result, "haiku_lexical", haiku_lexical)
    haiku_iceberg_put(result, "friend_lexical", friend_lexical)
    haiku_iceberg_put(result, "haiku_contact", haiku_contact)
    haiku_iceberg_put(result, "friend_contact", friend_contact)
    return result

def haiku_iceberg_new(core, settings):
    haiku_iceberg_settings(settings)
    assert(record_get(core, "version") == 3, "Haiku iceberg begins with the complete dream life")
    haiku_lexical = haiku_lexical_new("haiku", 0.5)
    friend_lexical = haiku_lexical_new("friend", 0.5)
    haiku_contact = haiku_contact_new("haiku", 5751)
    friend_contact = haiku_contact_new("friend", 5752)
    return haiku_iceberg_pack(record_clone(core), haiku_lexical, friend_lexical, haiku_contact, friend_contact, settings, list_new(), zeros(1))

# Activation records an actual calendar boundary. Existing v1 lives stay v1
# until the caller explicitly requests this detached, idempotent upgrade.
def haiku_iceberg_enable_janus(life, day, mode, tokenizer):
    haiku_iceberg_check(life, tokenizer)
    result = record_clone(life)
    if record_get(result, "version") >= 2:
        return result
    haiku_lexical = haiku_iceberg_part(result, "haiku_lexical")
    friend_lexical = haiku_iceberg_part(result, "friend_lexical")
    haiku_janus = haiku_janus_new("haiku", mode, record_get(haiku_lexical, "alpha"), day, 0)
    friend_janus = haiku_janus_new("friend", mode, record_get(friend_lexical, "alpha"), day, 6)
    haiku_iceberg_put(result, "haiku_janus", haiku_janus)
    haiku_iceberg_put(result, "friend_janus", friend_janus)
    record_set(result, "version", 2)
    haiku_iceberg_check(result, tokenizer)
    return result

# Learning starts at each contact's present external clock. Existing profiles
# retain their exact history until the caller explicitly enables this organ.
def haiku_iceberg_enable_words(life, tokenizer):
    haiku_iceberg_check(life, tokenizer)
    assert(record_get(life, "version") >= 2, "Haiku word learning requires an owned Janus life")
    result = record_clone(life)
    if record_get(result, "version") >= 3:
        return result
    owners = haiku_words("haiku_contact friend_contact")
    cursor = 0
    while cursor < 2:
        name = list_get(owners, cursor)
        contact = haiku_contact_enable_learning(haiku_iceberg_part(result, name))
        haiku_iceberg_put(result, name, contact)
        cursor = cursor + 1
    record_set(result, "version", 3)
    haiku_iceberg_check(result, tokenizer)
    return result

# Dream symbols start at the present contact and actual dream boundary. A
# saved profile changes only through this explicit, detached activation.
def haiku_iceberg_enable_symbols(life, enabled, tokenizer):
    haiku_iceberg_check(life, tokenizer)
    haiku_state_integer(enabled, 0, 1)
    assert(record_get(life, "version") >= 3, "Haiku symbols require an owned word-learning life")
    result = record_clone(life)
    if record_get(result, "version") >= 4:
        return result
    core = haiku_iceberg_part(result, "voice")
    dream_count = haiku_dream_check(core)
    owners = haiku_words("haiku_contact friend_contact")
    cursor = 0
    while cursor < 2:
        name = list_get(owners, cursor)
        contact = haiku_contact_enable_symbols(haiku_iceberg_part(result, name), enabled, dream_count)
        haiku_iceberg_put(result, name, contact)
        cursor = cursor + 1
    record_set(result, "version", 4)
    haiku_iceberg_check(result, tokenizer)
    return result

def haiku_iceberg_check(life, tokenizer):
    haiku_state_fields(life, "format", "string")
    haiku_state_fields(life, "version", "float")
    haiku_state_fields(life, "settings admission_values", "array")
    haiku_state_fields(life, "admission_text", "list")
    version = record_get(life, "version")
    assert(text_equal(record_get(life, "format"), "haiku-iceberg") and (version == 1 or version == 2 or version == 3 or version == 4), "Haiku iceberg format is unsupported")
    haiku_iceberg_settings(record_get(life, "settings"))
    core = haiku_iceberg_part(life, "voice")
    haiku_state_check(core, tokenizer)
    assert(record_get(core, "version") == 3, "Haiku iceberg voice must retain its dream life")
    haiku_lexical = haiku_iceberg_part(life, "haiku_lexical")
    friend_lexical = haiku_iceberg_part(life, "friend_lexical")
    haiku_contact = haiku_iceberg_part(life, "haiku_contact")
    friend_contact = haiku_iceberg_part(life, "friend_contact")
    haiku_lexical_check(haiku_lexical)
    haiku_lexical_check(friend_lexical)
    haiku_contact_check(haiku_contact)
    haiku_contact_check(friend_contact)
    contact_version = 1 + (version >= 3) + (version >= 4)
    assert(record_get(haiku_contact, "version") == contact_version and record_get(friend_contact, "version") == contact_version, "Haiku iceberg contact profile differs")
    assert(text_equal(record_get(haiku_lexical, "owner"), "haiku") and text_equal(record_get(friend_lexical, "owner"), "friend"), "Haiku iceberg lexical owners differ")
    assert(record_get(haiku_lexical, "clock") <= record_get(core, "turn") and record_get(friend_lexical, "clock") <= record_get(core, "turn"), "Haiku iceberg lexical history is ahead of its voice")
    assert(text_equal(record_get(haiku_contact, "p:owner"), "haiku") and text_equal(record_get(friend_contact, "p:owner"), "friend"), "Haiku iceberg contact owners differ")
    assert(record_get(haiku_contact, "p:clock") <= record_get(core, "turn") and record_get(friend_contact, "p:clock") <= record_get(core, "turn"), "Haiku iceberg contact is ahead of its voice")
    if version >= 4:
        dream_count = haiku_dream_check(core)
        dialogs = record_get(core, "dream_dialogs")
        owners = haiku_words("haiku_contact friend_contact")
        cursor = 0
        while cursor < 2:
            contact = haiku_iceberg_part(life, list_get(owners, cursor))
            clock = record_get(contact, "symbol_clock")
            assert(clock[1] <= record_get(core, "turn") and clock[3] <= record_get(core, "turn") and clock[42] <= record_get(core, "turn"), "Haiku symbols are ahead of their voice")
            assert(clock[2] <= dream_count and clock[4] <= dream_count, "Haiku symbols claim an absent dream boundary")
            # This composite's only F peer source is an actual H dream line;
            # unlike the wider standalone contact API, none are ineligible.
            assert(clock[7] == min(128, clock[26 + cursor * 6]), "Haiku symbols lost accepted external encounters")
            # Activation captures the global ordinal even if a quiet contact
            # lags the voice. Every subsequently processed boundary is exact.
            if clock[4] > clock[2]:
                assert(dialogs[(clock[4] - 1) * 3] == clock[42], "Haiku symbols name another processed dream turn")
            nodes = record_get(contact, "symbol_nodes")
            index = 0
            while index < clock[8]:
                assert(nodes[index * 10 + 4] <= record_get(core, "turn") and nodes[index * 10 + 5] <= dream_count, "Haiku symbol birth is ahead of its actual dream")
                assert(dialogs[(nodes[index * 10 + 5] - 1) * 3] == nodes[index * 10 + 4], "Haiku symbol birth names another actual dream turn")
                index = index + 1
            cursor = cursor + 1
    expected = 10 + list_len(record_keys(core)) + list_len(record_keys(haiku_lexical)) + list_len(record_keys(friend_lexical)) + list_len(record_keys(haiku_contact)) + list_len(record_keys(friend_contact))
    if version >= 2:
        owners = haiku_words("haiku friend")
        cursor = 0
        while cursor < 2:
            owner = list_get(owners, cursor)
            balance = haiku_iceberg_part(life, text_concat(owner, "_janus"))
            haiku_janus_check(balance)
            assert(text_equal(record_get(balance, "owner"), owner), "Haiku iceberg Janus owner differs")
            assert(record_get(balance, "witness_source") == cursor * 6, "Haiku iceberg Janus witness policy differs")
            assert(record_get(balance, "clock") <= record_get(core, "turn"), "Haiku iceberg Janus history is ahead of its voice")
            expected = expected + list_len(record_keys(balance)) + 1
            cursor = cursor + 1
    assert(list_len(record_keys(life)) == expected, "Haiku iceberg fields differ")
    # Eight text coordinates and eight numerical coordinates per admission.
    names = record_get(life, "admission_text")
    values = record_get(life, "admission_values")
    count = list_len(names) / 8
    assert(count == floor(count) and count <= 32, "Haiku iceberg admission history is invalid")
    assert(len(values) == max(1, count * 8), "Haiku iceberg admission columns differ")
    haiku_lexical_vector(values, max(1, count * 8), 16777216)
    if count == 0:
        assert(values[0] == 0, "Haiku iceberg empty admission sentinel differs")
    cursor = 0
    while cursor < count:
        word = list_get(names, cursor * 8)
        assert(text_equal(list_get(names, cursor * 8 + 1), "en"), "Haiku iceberg admission language is unsupported")
        assert(text_equal(list_get(names, cursor * 8 + 2), "haiku"), "Haiku iceberg admission owner differs")
        assert(list_find(haiku_lexical_words(), word) >= 0, "Haiku iceberg admitted word is outside its reviewed pool")
        assert(text_equal(list_get(names, cursor * 8 + 7), "text-context-v1"), "Haiku iceberg admission surface differs")
        assert(text_len(list_get(names, cursor * 8 + 6)) <= 64, "Haiku iceberg admission fragment exceeds its budget")
        assert(map_has(record_get(core, "weights"), word) and map_has(record_get(core, "syllables"), word), "Haiku iceberg admitted word is absent")
        haiku_state_integer(values[cursor * 8], 1, record_get(core, "turn"))
        source = haiku_state_integer(values[cursor * 8 + 1], 2, 4)
        haiku_state_integer(values[cursor * 8 + 2], 1, 999999)
        haiku_state_integer(values[cursor * 8 + 3], 0, 1)
        alpha = values[cursor * 8 + 4]
        assert(alpha >= 0 and alpha <= 1, "Haiku iceberg admission mixture is invalid")
        assert(source != 2 or alpha == 1, "Haiku iceberg A admission mixture differs")
        assert(source != 3 or alpha == 0, "Haiku iceberg B admission mixture differs")
        identity_a = list_get(names, cursor * 8 + 3)
        identity_b = list_get(names, cursor * 8 + 4)
        identity_tokenizer = list_get(names, cursor * 8 + 5)
        haiku_lexical_identity(identity_a)
        haiku_lexical_identity(identity_b)
        haiku_lexical_identity(identity_tokenizer)
        assert(text_len(identity_tokenizer) == 64, "Haiku iceberg admission tokenizer is missing")
        assert(source == 3 or text_len(identity_a) == 64, "Haiku iceberg admission A identity is missing")
        assert(source == 2 or text_len(identity_b) == 64, "Haiku iceberg admission B identity is missing")
        assert(source != 3 or text_len(identity_a) == 0, "Haiku iceberg B admission also claims A")
        assert(source != 2 or text_len(identity_b) == 0, "Haiku iceberg A admission also claims B")
        assert(values[cursor * 8 + 5] == map_get(record_get(core, "syllables"), word), "Haiku iceberg admitted syllable count differs")
        cursor = cursor + 1
    return 1

# Freeze actual provider availability with the input, before worker capture.
def haiku_iceberg_request(life, source, body_a, body_b):
    day = 0
    if record_get(life, "version") >= 2:
        day = utc_day()
    return haiku_iceberg_request_at(life, source, body_a, body_b, day)

def haiku_iceberg_request_at(life, source, body_a, body_b, day):
    request = record_new()
    core = haiku_iceberg_part(life, "voice")
    record_set(request, "base_revision", record_get(core, "turn"))
    record_set(request, "input", source)
    record_set(request, "settings", record_get(life, "settings"))
    record_set(request, "a_ready", model_ready(body_a))
    record_set(request, "b_ready", model_ready(body_b))
    record_set(request, "a_identity", model_identity(body_a))
    record_set(request, "b_identity", model_identity(body_b))
    if record_get(life, "version") >= 2:
        haiku_janus_calendar(day)
        record_set(request, "day", day)
    return record_clone(request)

def haiku_iceberg_inner_event(core):
    bridge = record_get(core, "bridge_event")
    climate = zeros(4)
    climate[0] = map_get(bridge, "dissonance")
    climate[1] = map_get(bridge, "novelty")
    climate[2] = map_get(bridge, "arousal")
    climate[3] = map_get(bridge, "entropy")
    history = record_get(core, "meta_history")
    turn = record_get(core, "turn")
    return haiku_contact_event("haiku", list_get(history, list_len(history) - 1), "en", climate, record_get(core, "ring_coherence"), map_get(bridge, "quality_after"), 5, turn, turn)

# At most two reviewed words become future candidates. This adds no invented
# human observation or trigram; the original Markov and RAE machinery speaks.
def haiku_iceberg_admit(core, contact, receipt, ledger, budget):
    if budget == 0 or record_get(receipt, "committed") == 0:
        return 0
    words = record_get(receipt, "words")
    base_scores = record_get(receipt, "scores")
    scores = haiku_contact_rank(contact, words, base_scores, "en")
    syllables = record_get(receipt, "syllables")
    count = 0
    while count < budget:
        best = -1
        index = 0
        while index < list_len(words):
            word = list_get(words, index)
            if list_find(record_get(core, "vocab"), word) < 0:
                if best < 0:
                    best = index
                else:
                    if scores[index] > scores[best]:
                        best = index
            index = index + 1
        if best < 0:
            return count
        word = list_get(words, best)
        origin = text_concat("lexical:", record_get(receipt, "owner"))
        haiku_cloud_add(record_get(core, "weights"), record_get(core, "frequencies"), record_get(core, "last_used"), record_get(core, "origins"), word, 1, record_get(core, "turn"), origin)
        list_push(record_get(core, "vocab"), word)
        map_set(record_get(core, "syllables"), word, syllables[best])
        old_text = record_get(ledger, "text")
        old_values = record_get(ledger, "values")
        old_count = list_len(old_text) / 8
        skip = max(0, old_count - 31)
        texts = list_slice(old_text, skip * 8, list_len(old_text))
        values = zeros((old_count - skip + 1) * 8)
        index = skip * 8
        while index < old_count * 8:
            values[index - skip * 8] = old_values[index]
            index = index + 1
        list_push(texts, word)
        list_push(texts, "en")
        list_push(texts, record_get(receipt, "owner"))
        list_push(texts, record_get(receipt, "identity_a"))
        list_push(texts, record_get(receipt, "identity_b"))
        list_push(texts, record_get(receipt, "tokenizer"))
        list_push(texts, record_get(receipt, "fragment"))
        list_push(texts, record_get(receipt, "surface"))
        offset = (old_count - skip) * 8
        values[offset] = record_get(core, "turn")
        values[offset + 1] = record_get(receipt, "source")
        values[offset + 2] = record_get(receipt, "event")
        values[offset + 3] = record_get(receipt, "direction")
        values[offset + 4] = record_get(receipt, "alpha")
        values[offset + 5] = syllables[best]
        values[offset + 6] = base_scores[best]
        values[offset + 7] = scores[best]
        record_set(ledger, "text", texts)
        record_set(ledger, "values", values)
        count = count + 1
    return count

# A returned neural proposal retains its parent encounter. Projection is
# optional; the words and their original provenance remain in the receipt.
def haiku_iceberg_model_contact(contact, parent, receipt, body_a, body_b):
    if record_get(receipt, "committed") == 0:
        return 0
    proposals = record_get(receipt, "proposals")
    text = text_concat(text_concat(list_get(proposals, 0), " "), list_get(proposals, 1))
    event = haiku_contact_derive(parent, record_get(receipt, "owner"), text, record_get(receipt, "source"), record_get(receipt, "event"), record_get(receipt, "turn"))
    event = haiku_contact_enrich(contact, event, receipt, body_a, body_b)
    result = haiku_contact_publish(contact, event)
    return record_get(result, "committed")

# One pure plan serves execution and independent publication verification. The
# request carries the same original parent, trajectory and bounded text grafts.
def haiku_iceberg_lexical_plan(owner, before, core, experience, settings, alpha):
    turn = record_get(experience, "turn")
    climate = record_get(experience, "observation")
    rings = record_get(core, "ring_coherence")
    start = list_len(record_get(before, "dream_history"))
    dream = record_get(core, "dream_history")
    pairs = floor((list_len(dream) - start) / 2)
    last_friend = start + pairs * 2 - 1
    if text_equal(owner, "haiku"):
        direction = (turn - 1) - floor((turn - 1) / 2) * 2
        parent = haiku_contact_event("human", record_get(experience, "input"), "en", climate, rings, record_get(experience, "quality"), 0, turn, turn)
        if direction == 0 and record_get(before, "turn") > 0:
            parent = haiku_iceberg_inner_event(before)
        request = haiku_lexical_request(owner, record_get(parent, "text"), record_get(parent, "source"), turn, turn, direction, alpha, settings[1])
        haiku_lexical_lineage(request, record_get(parent, "source"), record_get(parent, "event"), record_get(parent, "origin_source"), record_get(parent, "origin_event"))
        if settings[3]:
            inner = haiku_iceberg_inner_event(core)
            haiku_lexical_graft(request, record_get(inner, "text"), 5, turn)
            if pairs > 0:
                haiku_lexical_graft(request, list_get(dream, last_friend), 6, last_friend + 1)
    else:
        assert(text_equal(owner, "friend") and pairs > 0, "Haiku lexical plan needs a delivered friend exchange")
        dream_count = haiku_dream_check(core)
        direction = (dream_count - 1) - floor((dream_count - 1) / 2) * 2
        parent = haiku_contact_event(owner, list_get(dream, last_friend), "en", climate, rings, 0.5, 7, last_friend + 1, turn)
        request = haiku_lexical_request(owner, record_get(parent, "text"), 7, last_friend + 1, turn, direction, alpha, settings[1])
        if settings[3]:
            haiku_lexical_graft(request, list_get(dream, last_friend - 1), 6, last_friend)
    plan = record_new()
    haiku_iceberg_put(plan, "parent", parent)
    haiku_iceberg_put(plan, "request", request)
    return plan

def haiku_iceberg_tail(pending, before, experience, request, tokenizer, body_a, body_b):
    # Same-turn lives can have different private histories. Carry the entire
    # exact predecessor, not just five revision counters, through completion.
    predecessor = record_clone(pending)
    haiku_iceberg_put(predecessor, "voice", before)
    core = haiku_iceberg_part(pending, "voice")
    tail = haiku_session_tail(core, experience, tokenizer)
    core = haiku_session_result_check(before, tail, experience, tokenizer)
    haiku_lexical = haiku_iceberg_part(pending, "haiku_lexical")
    friend_lexical = haiku_iceberg_part(pending, "friend_lexical")
    haiku_contact = haiku_iceberg_part(pending, "haiku_contact")
    friend_contact = haiku_iceberg_part(pending, "friend_contact")
    version = record_get(pending, "version")
    if version >= 2:
        day = record_get(request, "day")
        haiku_janus = haiku_iceberg_part(pending, "haiku_janus")
        friend_janus = haiku_iceberg_part(pending, "friend_janus")
    settings = record_get(pending, "settings")
    ledger = record_new()
    record_set(ledger, "text", record_get(pending, "admission_text"))
    record_set(ledger, "values", record_get(pending, "admission_values"))
    turn = record_get(experience, "turn")
    if settings[0]:
        climate = record_get(experience, "observation")
        rings = record_get(core, "ring_coherence")
        quality = record_get(experience, "quality")
        human = haiku_contact_event("human", record_get(experience, "input"), "en", climate, rings, quality, 0, turn, turn)
        haiku_contact_publish(haiku_contact, human)
        if version >= 2:
            haiku_janus_witness(haiku_janus, human, day)
        # The cloud event carries the actual remembered recent triples, capped
        # at their existing thirty-word snapshot. It is an internal observation.
        recent = record_get(core, "recent")
        cloud_text = ""
        cursor = 0
        while cursor < list_len(recent):
            if cursor > 0:
                cloud_text = text_concat(cloud_text, " ")
            cloud_text = text_concat(cloud_text, list_get(recent, cursor))
            cursor = cursor + 1
        cloud = haiku_contact_event("haiku", cloud_text, "en", climate, rings, quality, 1, turn, turn)
        haiku_contact_publish(haiku_contact, cloud)
        inner = haiku_iceberg_inner_event(core)
        haiku_contact_publish(haiku_contact, inner)

        # Deliver each actual dream line once, in the original alternating
        # order. A friend acquires this history only when that line reaches it.
        start = list_len(record_get(before, "dream_history"))
        dream = record_get(core, "dream_history")
        cursor = start
        last_friend = -1
        while cursor < list_len(dream):
            line = list_get(dream, cursor)
            part = cursor - start
            speaker = "haiku"
            if part - floor(part / 2) * 2 == 1:
                speaker = "friend"
            native = haiku_contact_event(speaker, line, "en", climate, rings, 0.5, 7, cursor + 1, turn)
            if text_equal(speaker, "haiku"):
                haiku_contact_publish(haiku_contact, native)
                delivered = haiku_contact_derive(native, "friend", line, 6, cursor + 1, turn)
                haiku_contact_publish(friend_contact, delivered)
                if version >= 2:
                    haiku_janus_witness(friend_janus, delivered, day)
            else:
                haiku_contact_publish(friend_contact, native)
                delivered = haiku_contact_derive(native, "haiku", line, 6, cursor + 1, turn)
                haiku_contact_publish(haiku_contact, delivered)
                last_friend = cursor
            cursor = cursor + 1

        # Retrospective contact revisits the previous inner voice; prospective
        # contact begins with this human turn. Each trajectory retains its own
        # context and the pass fixes its presence's all-parameter balance.
        lexical_candidate = record_clone(haiku_lexical)
        if version >= 2:
            balance = haiku_janus_snapshot(haiku_janus, day)
            record_set(lexical_candidate, "alpha", record_get(balance, "alpha"))
        plan = haiku_iceberg_lexical_plan("haiku", before, core, experience, settings, record_get(lexical_candidate, "alpha"))
        parent = haiku_iceberg_part(plan, "parent")
        lexical_request = haiku_iceberg_part(plan, "request")
        proposal = haiku_lexical_pass(lexical_candidate, body_a, body_b, lexical_request)
        if record_get(proposal, "committed"):
            record_replace(haiku_lexical, lexical_candidate)
            if version >= 2:
                haiku_janus_expect(haiku_janus, proposal, day)
        haiku_iceberg_model_contact(haiku_contact, parent, proposal, body_a, body_b)
        haiku_iceberg_admit(core, haiku_contact, proposal, ledger, settings[2])
        # This slot records the cloud at completed-turn publication. Frozen
        # learning features and the observed human climate retain their values.
        journal_values = record_get(core, "journal_values")
        journal_values[len(journal_values) - 11] = map_len(record_get(core, "weights"))

        if last_friend >= 0:
            lexical_candidate = record_clone(friend_lexical)
            if version >= 2:
                balance = haiku_janus_snapshot(friend_janus, day)
                record_set(lexical_candidate, "alpha", record_get(balance, "alpha"))
            plan = haiku_iceberg_lexical_plan("friend", before, core, experience, settings, record_get(lexical_candidate, "alpha"))
            parent = haiku_iceberg_part(plan, "parent")
            lexical_request = haiku_iceberg_part(plan, "request")
            proposal = haiku_lexical_pass(lexical_candidate, body_a, body_b, lexical_request)
            if record_get(proposal, "committed"):
                record_replace(friend_lexical, lexical_candidate)
                if version >= 2:
                    haiku_janus_expect(friend_janus, proposal, day)
            haiku_iceberg_model_contact(friend_contact, parent, proposal, body_a, body_b)
        # The actual dream has now delivered every line and both optional
        # lexical contacts have finished. A newborn can affect later turns.
        if version >= 4:
            old_count = haiku_dream_check(before)
            dream_count = haiku_dream_check(core)
            if dream_count > old_count:
                assert(dream_count == old_count + 1, "Haiku symbols require one actual new dream")
                haiku_contact_symbols_dream(haiku_contact, dream_count, turn)
                haiku_contact_symbols_dream(friend_contact, dream_count, turn)
    completed = haiku_iceberg_pack(core, haiku_lexical, friend_lexical, haiku_contact, friend_contact, settings, record_get(ledger, "text"), record_get(ledger, "values"))
    if version >= 2:
        record_set(completed, "version", version)
        haiku_iceberg_put(completed, "haiku_janus", haiku_janus)
        haiku_iceberg_put(completed, "friend_janus", friend_janus)
    haiku_iceberg_check(completed, tokenizer)
    result = record_new()
    record_set(result, "format", "haiku-iceberg-result")
    record_set(result, "version", 1)
    haiku_iceberg_put(result, "base", predecessor)
    haiku_iceberg_put(result, "life", completed)
    haiku_iceberg_put(result, "request", request)
    haiku_iceberg_put(result, "experience", experience)
    return result

# The caller prepares the same foreground as stable chat. Its immutable
# experience is captured alongside the model identities and all private lives.
def haiku_iceberg_turn(life, source, tokenizer, body_a, body_b, worker):
    day = 0
    if record_get(life, "version") >= 2:
        day = utc_day()
    return haiku_iceberg_turn_at(life, source, tokenizer, body_a, body_b, worker, day)

def haiku_iceberg_turn_at(life, source, tokenizer, body_a, body_b, worker, day):
    haiku_iceberg_check(life, tokenizer)
    haiku_state_integer(worker, 0, 1)
    before = haiku_iceberg_part(life, "voice")
    core = record_clone(before)
    experience = haiku_session_prepare(core, source, tokenizer)
    request = haiku_iceberg_request_at(life, source, body_a, body_b, day)
    pending = record_clone(life)
    haiku_iceberg_put(pending, "voice", core)
    if worker:
        SPAWN iceberg_tail:
            return haiku_iceberg_tail(pending, before, experience, request, tokenizer, body_a, body_b)
        AWAIT iceberg_tail INTO result
    else:
        result = haiku_iceberg_tail(pending, before, experience, request, tokenizer, body_a, body_b)
    completed = haiku_iceberg_check_sources(life, result, experience, request, tokenizer, body_a, body_b)
    record_replace(life, completed)
    return record_get(experience, "output")

# The original five-argument entry is sufficient only for the v1 profile.
# Janus and learning profiles need immutable providers and source encounters.
def haiku_iceberg_result_check(life, result, experience, request, tokenizer):
    assert(record_get(life, "version") == 1, "Haiku Janus completion requires immutable source validation")
    return haiku_iceberg_result_structure(life, result, experience, request, tokenizer)

# Validate the envelope and accepted foreground before reconstructing any
# Janus transition. This alone is not a Janus/learning publication boundary.
def haiku_iceberg_result_structure(life, result, experience, request, tokenizer):
    assert(text_equal(record_get(result, "format"), "haiku-iceberg-result") and record_get(result, "version") == 1, "Haiku iceberg completion format differs")
    received_request = haiku_iceberg_part(result, "request")
    received_experience = haiku_iceberg_part(result, "experience")
    assert(record_equal(request, received_request), "Haiku iceberg completion belongs to another request")
    assert(record_equal(experience, received_experience), "Haiku iceberg completion belongs to another experience")
    predecessor = haiku_iceberg_part(result, "base")
    assert(record_equal(life, predecessor), "Haiku iceberg completion belongs to another private life")
    core = haiku_iceberg_part(life, "voice")
    assert(record_get(core, "turn") == record_get(request, "base_revision"), "Haiku iceberg completion is stale")
    assert(record_get(experience, "base_revision") == record_get(core, "turn"), "Haiku iceberg experience is stale")
    assert(text_equal(record_get(experience, "input"), record_get(request, "input")), "Haiku iceberg input differs")
    completed = haiku_iceberg_part(result, "life")
    expected = 6 + list_len(record_keys(predecessor)) + list_len(record_keys(completed)) + list_len(record_keys(request)) + list_len(record_keys(experience))
    assert(list_len(record_keys(result)) == expected, "Haiku iceberg completion has extra fields")
    haiku_iceberg_check(completed, tokenizer)
    assert(record_get(completed, "version") == record_get(life, "version"), "Haiku iceberg completion changed its profile")
    request_fields = 7
    if record_get(life, "version") >= 2:
        request_fields = 8
        day = record_get(request, "day")
        haiku_janus_calendar(day)
        owners = haiku_words("haiku_janus friend_janus")
        fields = haiku_words("mode fixed_alpha birth_day calendar witness_source")
        cursor = 0
        while cursor < 2:
            owner = list_get(owners, cursor)
            old_balance = haiku_iceberg_part(life, owner)
            new_balance = haiku_iceberg_part(completed, owner)
            old_profile = record_new()
            new_profile = record_new()
            field = 0
            while field < list_len(fields):
                name = list_get(fields, field)
                record_set(old_profile, name, record_get(old_balance, name))
                record_set(new_profile, name, record_get(new_balance, name))
                field = field + 1
            assert(record_equal(old_profile, new_profile), "Haiku iceberg completion changed its Janus profile")
            assert(record_get(new_balance, "revision") >= record_get(old_balance, "revision"), "Haiku iceberg completion reversed its Janus history")
            if record_get(new_balance, "revision") > record_get(old_balance, "revision"):
                assert(record_get(new_balance, "last_day") == day, "Haiku iceberg completion belongs to another calendar day")
                assert(record_get(new_balance, "clock") == record_get(experience, "turn"), "Haiku iceberg completion belongs to another Janus turn")
            else:
                assert(record_equal(old_balance, new_balance), "Haiku iceberg completion changed an idle Janus owner")
            cursor = cursor + 1
    assert(list_len(record_keys(request)) == request_fields, "Haiku iceberg request fields differ")
    completed_core = haiku_iceberg_part(completed, "voice")
    assert(record_get(completed_core, "turn") == record_get(core, "turn") + 1, "Haiku iceberg completion turn differs")
    assert(record_get(completed_core, "turn") == record_get(experience, "turn"), "Haiku iceberg completed experience turn differs")
    # Reuse the stable publisher's profile, tokenizer and exact inner-history
    # ownership checks after optional vocabulary admission.
    stable_result = record_new()
    record_set(stable_result, "format", "haiku-tail-result")
    record_set(stable_result, "version", 1)
    record_set(stable_result, "state_keys", record_keys(completed_core))
    record_set(stable_result, "experience_keys", record_keys(experience))
    keys = record_keys(completed_core)
    cursor = 0
    while cursor < list_len(keys):
        key = list_get(keys, cursor)
        record_set(stable_result, text_concat("state:", key), record_get(completed_core, key))
        cursor = cursor + 1
    keys = record_keys(experience)
    cursor = 0
    while cursor < list_len(keys):
        key = list_get(keys, cursor)
        record_set(stable_result, text_concat("experience:", key), record_get(experience, key))
        cursor = cursor + 1
    checked_core = haiku_session_result_check(core, stable_result, experience, tokenizer)
    settings_receipt = record_new()
    record_set(settings_receipt, "settings", record_get(completed, "settings"))
    settings_before = record_new()
    record_set(settings_before, "settings", record_get(request, "settings"))
    assert(record_equal(settings_receipt, settings_before), "Haiku iceberg completion changed its settings")
    return completed

# Rebuild Janus, lexical, learned-word and symbol transitions from the predecessor and
# current accepted encounters. Each enabled model pass is independently run
# again against its immutable sources; worker-provided scores are never proof.
# Voice learners, dreams, prototype caches, admission and random streams are
# not repeated. Private evidence alone is replayed from accepted encounters.
def haiku_iceberg_check_sources(life, result, experience, request, tokenizer, body_a, body_b):
    completed = haiku_iceberg_result_structure(life, result, experience, request, tokenizer)
    if record_get(life, "version") == 1:
        return completed
    assert(model_ready(body_a) == record_get(request, "a_ready") and model_ready(body_b) == record_get(request, "b_ready"), "Haiku Janus verification provider availability differs")
    assert(text_equal(model_identity(body_a), record_get(request, "a_identity")) and text_equal(model_identity(body_b), record_get(request, "b_identity")), "Haiku Janus verification provider identity differs")
    before = haiku_iceberg_part(life, "voice")
    core = haiku_iceberg_part(completed, "voice")
    settings = record_get(request, "settings")
    turn = record_get(experience, "turn")
    day = record_get(request, "day")
    old_dream = record_get(before, "dream_history")
    dream = record_get(core, "dream_history")
    start = list_len(old_dream)
    assert(list_len(dream) >= start, "Haiku Janus completion lost an earlier dream encounter")
    cursor = 0
    while cursor < start:
        assert(text_equal(list_get(old_dream, cursor), list_get(dream, cursor)), "Haiku Janus completion rewrote an earlier dream encounter")
        cursor = cursor + 1
    old_count = haiku_dream_check(before)
    dream_count = haiku_dream_check(core)
    assert(dream_count == old_count or dream_count == old_count + 1, "Haiku Janus completion changed the dream encounter count")
    old_dialogs = record_get(before, "dream_dialogs")
    dialogs = record_get(core, "dream_dialogs")
    cursor = 0
    while cursor < old_count * 3:
        assert(old_dialogs[cursor] == dialogs[cursor], "Haiku Janus completion rewrote an earlier dream boundary")
        cursor = cursor + 1
    if dream_count > old_count:
        assert(dialogs[old_count * 3] == turn, "Haiku Janus completion delivered a dream from another turn")
        assert(text_equal(list_get(dream, start), record_get(experience, "output")), "Haiku Janus dream began with another foreground response")
    owners = haiku_words("haiku friend")
    index = 0
    while index < 2:
        owner = list_get(owners, index)
        balance_name = text_concat(owner, "_janus")
        lexical_name = text_concat(owner, "_lexical")
        balance = haiku_iceberg_part(life, balance_name)
        lexical = haiku_iceberg_part(life, lexical_name)
        receipt = record_new()
        record_set(receipt, "committed", 0)
        if settings[0]:
            climate = record_get(experience, "observation")
            rings = record_get(core, "ring_coherence")
            if index == 0:
                human = haiku_contact_event("human", record_get(experience, "input"), "en", climate, rings, record_get(experience, "quality"), 0, turn, turn)
                haiku_janus_witness(balance, human, day)
            else:
                cursor = start
                while cursor < list_len(dream):
                    line = list_get(dream, cursor)
                    native = haiku_contact_event("haiku", line, "en", climate, rings, 0.5, 7, cursor + 1, turn)
                    delivered = haiku_contact_derive(native, "friend", line, 6, cursor + 1, turn)
                    haiku_janus_witness(balance, delivered, day)
                    cursor = cursor + 2
            if index == 0 or list_len(dream) - start >= 2:
                snapshot = haiku_janus_snapshot(balance, day)
                candidate = record_clone(lexical)
                record_set(candidate, "alpha", record_get(snapshot, "alpha"))
                plan = haiku_iceberg_lexical_plan(owner, before, core, experience, settings, record_get(candidate, "alpha"))
                lexical_request = haiku_iceberg_part(plan, "request")
                receipt = haiku_lexical_pass(candidate, body_a, body_b, lexical_request)
                if record_get(receipt, "committed"):
                    record_replace(lexical, candidate)
                    haiku_janus_expect(balance, receipt, day)
        assert(record_equal(balance, haiku_iceberg_part(completed, balance_name)), "Haiku Janus completion differs from its witnessed transition")
        assert(record_equal(lexical, haiku_iceberg_part(completed, lexical_name)), "Haiku lexical completion differs from its immutable source transition")
        if record_get(life, "version") >= 3:
            contact_name = text_concat(owner, "_contact")
            contact = haiku_iceberg_part(life, contact_name)
            published = haiku_iceberg_part(completed, contact_name)
            # Reconstruct the bounded receipt ring from every real
            # encounter, preserving earlier slots until their actual expiry.
            # The learner is tied to the same published source/text ancestry.
            rows = record_get(contact, "p:receipt_rows")
            texts = record_get(contact, "contact_text")
            meta = record_get(contact, "contact_meta")
            feature_rows = record_get(contact, "p:receipt_x")
            model_slots = zeros(32)
            seen = record_get(contact, "p:seen")
            slot = record_get(contact, "p:receipt_cursor")
            contact_clock = record_get(contact, "p:clock")
            count = 0
            prefix = 0
            if settings[0]:
                if index == 0:
                    prefix = 3
                count = prefix + list_len(dream) - start
            lexical_slot = count
            if record_get(receipt, "committed"):
                count = count + 1
            event_index = 0
            while event_index < count:
                if event_index == lexical_slot:
                    proposals = record_get(receipt, "proposals")
                    proposal_text = text_concat(text_concat(list_get(proposals, 0), " "), list_get(proposals, 1))
                    parent = haiku_iceberg_part(plan, "parent")
                    event = haiku_contact_derive(parent, owner, proposal_text, record_get(receipt, "source"), record_get(receipt, "event"), turn)
                    if record_get(life, "version") >= 4:
                        # The symbol clock receives a valid model encounter.
                        # Its provider metadata comes from the independently
                        # checked receipt; no prototype projection is repeated.
                        alpha = record_get(receipt, "alpha")
                        if record_get(receipt, "source") == 2:
                            alpha = 1
                        if record_get(receipt, "source") == 3:
                            alpha = 0
                        record_set(event, "alpha", alpha)
                        record_set(event, "availability", record_get(receipt, "availability") + (len(record_get(event, "rings")) == 3))
                        identity = haiku_words("PEN7-anchor4-v1")
                        list_push(identity, record_get(receipt, "identity_a"))
                        list_push(identity, record_get(receipt, "identity_b"))
                        list_push(identity, record_get(receipt, "tokenizer"))
                        list_push(identity, text_fixed(record_get(receipt, "source"), 0))
                        record_set(event, "identity", list_key(identity))
                else:
                    if index == 0 and event_index == 0:
                        event = haiku_contact_event("human", record_get(experience, "input"), "en", climate, rings, record_get(experience, "quality"), 0, turn, turn)
                    else:
                        if index == 0 and event_index == 1:
                            recent = record_get(core, "recent")
                            cloud_text = ""
                            cursor = 0
                            while cursor < list_len(recent):
                                if cursor > 0:
                                    cloud_text = text_concat(cloud_text, " ")
                                cloud_text = text_concat(cloud_text, list_get(recent, cursor))
                                cursor = cursor + 1
                            event = haiku_contact_event("haiku", cloud_text, "en", climate, rings, record_get(experience, "quality"), 1, turn, turn)
                        else:
                            if index == 0 and event_index == 2:
                                event = haiku_iceberg_inner_event(core)
                            else:
                                dream_index = start + event_index - prefix
                                line = list_get(dream, dream_index)
                                part = dream_index - start
                                speaker = "haiku"
                                if part - floor(part / 2) * 2 == 1:
                                    speaker = "friend"
                                event = haiku_contact_event(speaker, line, "en", climate, rings, 0.5, 7, dream_index + 1, turn)
                                if text_equal(speaker, owner) == 0:
                                    event = haiku_contact_derive(event, owner, line, 6, dream_index + 1, turn)
                source = record_get(event, "source")
                number = record_get(event, "event")
                if number > seen[source] and record_get(event, "replay") == 0:
                    # Source membership is independent of the parliament's
                    # arithmetic. The deterministic learner receives only
                    # these independently reconstructed, accepted events.
                    rows[slot * 9] = number
                    rows[slot * 9 + 1] = turn
                    rows[slot * 9 + 2] = source
                    model_slots[slot] = source >= 2 and source <= 4
                    if model_slots[slot] == 0:
                        # A confirming encounter retains the feature vector
                        # from before it taught its new private association.
                        features = haiku_contact_features(contact, event)
                        cursor = 0
                        while cursor < 96:
                            feature_rows[slot * 96 + cursor] = features[cursor]
                            cursor = cursor + 1
                    names = haiku_words("owner text language origin_owner parent_owner")
                    cursor = 0
                    while cursor < 5:
                        list_set(texts, slot * 6 + cursor, record_get(event, list_get(names, cursor)))
                        cursor = cursor + 1
                    names = haiku_words("parent_source parent_event origin_source origin_event")
                    cursor = 0
                    while cursor < 4:
                        meta[slot * 8 + cursor] = record_get(event, list_get(names, cursor))
                        cursor = cursor + 1
                    if record_get(life, "version") >= 4:
                        # All accepted sources advance their private receipt
                        # clocks; only the native external policy adds paths.
                        haiku_contact_symbols_step(contact, event)
                    if (index == 0 and source == 0) or (index == 1 and source == 6):
                        haiku_contact_learning_step(contact, event)
                    seen[source] = number
                    slot = slot + 1 - floor((slot + 1) / 32) * 32
                    contact_clock = turn
                event_index = event_index + 1
            if record_get(life, "version") >= 4 and settings[0] and dream_count > old_count:
                haiku_contact_symbols_dream(contact, dream_count, turn)
            expected = record_new()
            actual = record_new()
            fields = haiku_words("learn_clock learn_words learn_counts learn_rows learn_text bindings binding_history")
            cursor = 0
            while cursor < list_len(fields):
                name = list_get(fields, cursor)
                record_set(expected, name, record_get(contact, name))
                record_set(actual, name, record_get(published, name))
                cursor = cursor + 1
            assert(record_equal(expected, actual), "Haiku word learning completion differs from its witnessed transition")
            if record_get(life, "version") >= 4:
                fields = haiku_words("symbol_clock symbol_nodes symbol_rows symbol_text")
                cursor = 0
                while cursor < list_len(fields):
                    name = list_get(fields, cursor)
                    record_set(expected, name, record_get(contact, name))
                    record_set(actual, name, record_get(published, name))
                    cursor = cursor + 1
                assert(record_equal(expected, actual), "Haiku symbol completion differs from its witnessed transition")
            record_set(expected, "seen", seen)
            record_set(actual, "seen", record_get(published, "p:seen"))
            assert(record_equal(expected, actual), "Haiku word learning completion source clocks differ")
            assert(slot == record_get(published, "p:receipt_cursor") and contact_clock == record_get(published, "p:clock"), "Haiku word learning completion receipt boundary differs")
            actual_rows = record_get(published, "p:receipt_rows")
            actual_text = record_get(published, "contact_text")
            actual_meta = record_get(published, "contact_meta")
            actual_features = record_get(published, "p:receipt_x")
            cursor = 0
            while cursor < 32:
                part = 0
                while part < 3:
                    assert(rows[cursor * 9 + part] == actual_rows[cursor * 9 + part], "Haiku word learning completion receipt source differs")
                    part = part + 1
                part = 0
                while part < 5:
                    assert(text_equal(list_get(texts, cursor * 6 + part), list_get(actual_text, cursor * 6 + part)), "Haiku word learning completion receipt text differs")
                    part = part + 1
                part = 0
                while part < 4:
                    assert(meta[cursor * 8 + part] == actual_meta[cursor * 8 + part], "Haiku word learning completion receipt ancestry differs")
                    part = part + 1
                if model_slots[cursor] == 0:
                    part = 0
                    while part < 96:
                        assert(feature_rows[cursor * 96 + part] == actual_features[cursor * 96 + part], "Haiku word learning completion receipt features differ")
                        part = part + 1
                cursor = cursor + 1
        index = index + 1
    return completed
