# HAiKU's foreground voice. Runtime dependencies: AML + NoTorch.
IMPORT "src/session.aml"

# One process owns this checkpoint. Paths follow this source, even after amlc.
# Set state_path to "" for a fresh, unsaved conversation.
state_path = "haiku.state"

# These settings start a new life. An existing checkpoint carries its own
# tokenizer mode and training choice. Use a new path for another voice.
tokenizer_mode = "regex"
train_rae = 0
resuming = 0
if text_len(state_path) > 0:
    resuming = file_exists(state_path)
if resuming:
    restored = checkpoint_load(state_path)
    tokenizer_mode = record_get(restored, "tokenizer_mode")

tokenizer_model = 0
if text_equal(tokenizer_mode, "sentencepiece"):
    tokenizer_model = tokenizer_load("models/haiku_sp.model")

if resuming:
    haiku_state_check(restored, tokenizer_model)
    state = restored
else:
    state = haiku_state_new(tokenizer_mode, tokenizer_model, train_rae, 575, 57)
listening = 1

PRINT "HAiKU — the cloud is listening."
if resuming:
    PRINT "The cloud remembers. Our conversation continues."
PRINT "Write something. Type quit to leave."
while listening:
    PRINT "You:"
    line = read_line()
    if list_len(line) == 0:
        listening = 0
    else:
        source = haiku_input_strip(list_get(line, 0))
        action = haiku_input_action(source)
        if action == 2:
            listening = 0
        if action == 1:
            next_state = record_clone(state)
            spoken = haiku_session_turn(next_state, source, tokenizer_model)
            saved = 1
            if text_len(state_path) > 0:
                saved = checkpoint_save(next_state, state_path)
            # No allocation after file replacement: publish the same complete
            # state in memory, then reveal its response.
            record_swap(state, next_state)
            if saved == 2:
                PRINT "Memory written; storage could not confirm durability."
            PRINT ""
            PRINT "HAiKU:"
            PRINT spoken
            PRINT ""

PRINT "The cloud goes quiet."
