# Experimental life beneath Haiku's original voice. AML + NoTorch only.
IMPORT "src/iceberg_session.aml"

# One process owns this separate complete checkpoint. A saved life retains its
# settings; use a new path to begin another experiment.
state_path = "iceberg.state"
deeper_life = 1
lexical_bodies = 1
admission_budget = 2
self_injection = 1
owned_tail = 1
# New lives own a dynamic Janus calendar. Existing v1 checkpoints keep their
# profile until this explicit one-time upgrade is selected.
janus_balance = 1
upgrade_balance = 0
# New Janus lives can learn private word meanings from repeated encounters.
# Existing v1/v2 checkpoints require this separate explicit activation.
word_learning = 1
upgrade_words = 0
# Repeated external paths can acquire private symbols during an actual dream.
# Existing v1/v2/v3 lives keep their profile until explicitly upgraded.
dream_symbols = 1
upgrade_symbols = 0
# Dream partners can carry parent trees into their own symbol tables. Existing
# symbol lives keep version 4 until this explicit exchange upgrade is selected.
symbol_exchange = 1
upgrade_exchange = 0
# New lives use personal concept weights from their own prior encounters.
# Modes: 0 representation off, 1 equal teachers, 2 personal teacher weights.
# Saved v1-v5 lives retain their profile until this explicit activation.
personal_concepts = 2
upgrade_concepts = 0
# Form grows from this voice's present and remembered climate.
# Saved v1-v6 lives retain their profile until explicitly upgraded.
living_form = 1
upgrade_form = 0
# Sparse external contexts can acquire private, model-backed word bindings.
# Existing v7 lives opt in explicitly; missing bodies keep their quiet path.
neural_bindings = 1
upgrade_neural = 0
resuming = 0
if text_len(state_path) > 0:
    resuming = file_exists(state_path)
if resuming:
    life = checkpoint_load(state_path)
    core = haiku_iceberg_part(life, "voice")
    settings = record_get(life, "settings")
else:
    core = haiku_state_new("regex", 0, 0, 575, 57)
    core = haiku_state_enable_dreams(core, 0)
    settings = zeros(4)
    settings[0] = deeper_life
    settings[1] = lexical_bodies
    settings[2] = admission_budget
    settings[3] = self_injection
    life = haiku_iceberg_new(core, settings)
tokenizer_model = 0
if text_equal(record_get(core, "tokenizer_mode"), "sentencepiece"):
    tokenizer_model = tokenizer_load("models/haiku_sp.model")
haiku_iceberg_check(life, tokenizer_model)
if resuming == 0 and janus_balance:
    life = haiku_iceberg_enable_janus(life, utc_day(), 1, tokenizer_model)
if resuming and upgrade_balance:
    life = haiku_iceberg_enable_janus(life, utc_day(), 1, tokenizer_model)
if resuming == 0 and janus_balance and word_learning:
    life = haiku_iceberg_enable_words(life, tokenizer_model)
if resuming and upgrade_words:
    life = haiku_iceberg_enable_words(life, tokenizer_model)
if resuming == 0 and janus_balance and word_learning:
    life = haiku_iceberg_enable_symbols(life, dream_symbols, tokenizer_model)
if resuming and upgrade_symbols:
    life = haiku_iceberg_enable_symbols(life, dream_symbols, tokenizer_model)
if resuming == 0 and janus_balance and word_learning:
    life = haiku_iceberg_enable_exchange(life, symbol_exchange * dream_symbols, tokenizer_model)
if resuming and upgrade_exchange:
    life = haiku_iceberg_enable_exchange(life, symbol_exchange, tokenizer_model)
if resuming == 0 and janus_balance and word_learning:
    life = haiku_iceberg_enable_concepts(life, personal_concepts * dream_symbols, tokenizer_model)
if resuming and upgrade_concepts:
    life = haiku_iceberg_enable_concepts(life, personal_concepts, tokenizer_model)

if resuming == 0 and janus_balance and word_learning and living_form:
    life = haiku_iceberg_enable_form(life, tokenizer_model)
if resuming and upgrade_form:
    life = haiku_iceberg_enable_form(life, tokenizer_model)

if resuming == 0 and janus_balance and word_learning and living_form:
    life = haiku_iceberg_enable_neural(life, neural_bindings * dream_symbols * (personal_concepts > 0), tokenizer_model)
if resuming and upgrade_neural:
    life = haiku_iceberg_enable_neural(life, neural_bindings, tokenizer_model)

path_a = ""
path_b = ""
if settings[0] and settings[1]:
    path_a = "weights/haiku1.gguf"
    path_b = "weights/haiku2.gguf"
body_a = model_try_load(path_a)
body_b = model_try_load(path_b)
if resuming:
    haiku_iceberg_concepts_audit(life, body_a, body_b)
PRINT "HAiKU — the cloud is listening."
if resuming:
    PRINT "The cloud remembers. Our conversation continues."
PRINT "Write something. Type quit to leave."
listening = 1
while listening:
    PRINT "You:"
    line = read_line()
    if list_len(line) == 0:
        listening = 0
    else:
        source = haiku_input_strip(list_get(line, 0))
        action = haiku_input_action(source)
        if action == 2:
            listening = 0
        if action == 1:
            pending = record_clone(life)
            spoken = haiku_iceberg_turn(pending, source, tokenizer_model, body_a, body_b, owned_tail)
            saved = 1
            if text_len(state_path) > 0:
                saved = checkpoint_save(pending, state_path)
            record_swap(life, pending)
            if saved == 2:
                PRINT "Memory written; storage could not confirm durability."
            PRINT ""
            PRINT "HAiKU:"
            PRINT spoken
            PRINT ""
PRINT "The cloud goes quiet."
